{% extends '/dashboard/baseDashboard.html.twig' %}

{% block title %}Clasificaciones{% endblock %}

{% block body %}
  <div class="content">

    <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-2">
      <h2 class="mb-0">Clasificaciones</h2>
      <a href="{{ path('classification_new') }}" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Nueva solicitud
      </a>
    </div>

    <form method="GET" action="{{ path('classifications') }}" class="mb-4">
      <div class="input-group" style="max-width: 480px;">
        <span class="input-group-text"><i class="bi bi-search"></i></span>
        <input type="text" class="form-control" name="q" value="{{ q }}"
               placeholder="Buscar por mercancía, nombre químico, CAS o fracción...">
        {% if q %}
          <a href="{{ path('classifications') }}" class="btn btn-outline-secondary" title="Quitar búsqueda">
            <i class="bi bi-x-lg"></i>
          </a>
        {% endif %}
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
      </div>
    </form>

    {% if requests %}
      <table class="table table-striped align-middle">
        <thead>
          <tr>
            <th scope="col">Fecha</th>
            <th scope="col">Empresa</th>
            <th scope="col">Mercancía</th>
            <th scope="col">Solicitante</th>
            <th scope="col">Fracción arancelaria</th>
            <th scope="col">Archivos</th>
          </tr>
        </thead>
        <tbody>
          {% for r in requests %}
            <tr>
              <td>{{ r.createdAt|date('d/m/Y H:i') }}</td>
              <td>{{ r.company.name }}</td>
              <td>
                {{ r.merchandiseName }}
                {% if r.chemicalName or r.casNumber %}
                  <div class="text-body-secondary small">
                    {{ r.chemicalName }}{% if r.chemicalName and r.casNumber %} · {% endif %}{% if r.casNumber %}CAS {{ r.casNumber }}{% endif %}
                  </div>
                {% endif %}
              </td>
              <td>{{ r.requestedBy.name }}</td>
              <td>
                {% if r.isConfirmed %}
                  <span class="badge text-bg-success">{{ r.confirmedTariffFraction }}</span>
                  <div class="text-body-secondary small">{{ r.confirmedBy.name }} · {{ r.confirmedAt|date('d/m/Y') }}</div>
                  {% if r.confirmedJustification %}
                    <button type="button" class="btn btn-sm btn-link px-0" data-bs-toggle="modal" data-bs-target="#justificationModal{{ r.id }}">
                      <i class="bi bi-file-text"></i> Ver justificación
                    </button>
                  {% endif %}
                {% elseif is_granted('ROLE_EXECUTIVE') %}
                  <button type="button" class="btn btn-sm btn-outline-primary js-confirm-trigger"
                          data-bs-toggle="modal" data-bs-target="#confirmModal"
                          data-request-id="{{ r.id }}" data-merchandise-name="{{ r.merchandiseName }}">
                    <i class="bi bi-check2-circle"></i> Confirmar fracción
                  </button>
                {% else %}
                  <span class="badge text-bg-warning">Pendiente</span>
                {% endif %}
              </td>
              <td>
                {% if r.attachments|length %}
                  <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#docsModal{{ r.id }}">
                    <i class="bi bi-folder2-open"></i> Ver documentos ({{ r.attachments|length }})
                  </button>
                {% else %}
                  <span class="text-body-secondary">Sin documentos</span>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>

      {% for r in requests %}
        {% if r.attachments|length %}
          <div class="modal fade" id="docsModal{{ r.id }}" tabindex="-1" aria-labelledby="docsModalLabel{{ r.id }}" aria-hidden="true">
            <div class="modal-dialog">
              <div class="modal-content">
                <div class="modal-header">
                  <h5 class="modal-title" id="docsModalLabel{{ r.id }}">Documentos · {{ r.merchandiseName }}</h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                  <ul class="list-group mb-3">
                    {% for a in r.attachments %}
                      <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                        <span class="text-truncate">
                          <i class="bi bi-file-earmark"></i> {{ a.nombre }}
                          <span class="badge {{ (a.tipo ?? 'solicitud') == 'confirmacion' ? 'text-bg-success' : 'text-bg-secondary' }} ms-1">
                            {{ (a.tipo ?? 'solicitud') == 'confirmacion' ? 'Confirmación' : 'Solicitud' }}
                          </span>
                        </span>
                        <a href="{{ path('classification_attachment_download', { id: r.id, index: loop.index0 }) }}" class="btn btn-sm btn-outline-primary flex-shrink-0" download title="Descargar {{ a.nombre }}">
                          <i class="bi bi-download"></i>
                        </a>
                      </li>
                    {% endfor %}
                  </ul>
                  <a href="{{ path('classification_attachments_zip', { id: r.id }) }}" class="btn btn-primary w-100">
                    <i class="bi bi-file-earmark-zip"></i> Descargar todo (ZIP)
                  </a>
                </div>
              </div>
            </div>
          </div>
        {% endif %}
        {% if r.confirmedJustification %}
          <div class="modal fade" id="justificationModal{{ r.id }}" tabindex="-1" aria-labelledby="justificationModalLabel{{ r.id }}" aria-hidden="true">
            <div class="modal-dialog modal-lg">
              <div class="modal-content">
                <div class="modal-header">
                  <h5 class="modal-title" id="justificationModalLabel{{ r.id }}">Justificación del clasificador · {{ r.merchandiseName }}</h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                  {{ r.confirmedJustification|raw }}
                </div>
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}

      {# Un solo modal compartido para confirmar cualquier fila: js-confirm-trigger
         le pasa el id del expediente por data-request-id al abrirlo (ver JS abajo),
         en vez de repetir un formulario + un editor de Quill por cada fila pendiente. #}
      <div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
          <div class="modal-content">
            <form method="POST" id="confirmForm" enctype="multipart/form-data">
              <div class="modal-header">
                <h5 class="modal-title" id="confirmModalLabel">Confirmar fracción arancelaria</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
              </div>
              <div class="modal-body">
                <input type="hidden" name="_token" value="{{ csrf_token('classification_confirm') }}">
                <div class="mb-3">
                  <label class="form-label">Fracción arancelaria</label>
                  <input type="text" name="confirmedTariffFraction" id="confirmFractionInput" class="form-control"
                         placeholder="8471.30.01.99" title="Fracción a 10 dígitos: XXXX.XX.XX.XX"
                         pattern="\d{4}\.\d{2}\.\d{2}\.\d{2}" required>
                </div>
                <div class="mb-3">
                  <label class="form-label">Justificación del clasificador (opcional)</label>
                  <div class="form-text mb-2">
                    Pega aquí tal cual el texto del correo del clasificador (regulaciones, anexos, tasas...); conserva colores, negritas y enlaces.
                  </div>
                  <div id="confirmJustificationEditor" style="height: 240px; background: #fff;"></div>
                  <textarea name="confirmedJustification" id="confirmJustificationInput" class="d-none"></textarea>
                </div>
                <div class="mb-2">
                  <label class="form-label">Adjuntar correo del clasificador (opcional)</label>
                  <input type="file" name="confirmationFiles[]" class="form-control" multiple>
                  <div class="form-text">Permitidos: {{ allowedExtensions|join(', ') }}.</div>
                </div>
              </div>
              <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">
                  <i class="bi bi-check2-circle"></i> Confirmar
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    {% elseif q %}
      <div class="card text-center">
        <div class="card-header">Aviso</div>
        <div class="card-body">
          <h5 class="card-title">Sin resultados</h5>
          <p class="card-text">Nada coincide con "{{ q }}".</p>
        </div>
        <div class="card-footer text-body-secondary"></div>
      </div>
    {% else %}
      <div class="card text-center">
        <div class="card-header">Aviso</div>
        <div class="card-body">
          <h5 class="card-title">Sin registros</h5>
          <p class="card-text">Todavía no se solicita ninguna clasificación.</p>
          <a href="{{ path('classification_new') }}" class="btn btn-primary">Nueva solicitud</a>
        </div>
        <div class="card-footer text-body-secondary"></div>
      </div>
    {% endif %}

  </div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const modalEl = document.getElementById("confirmModal");

      if (!modalEl) {
        return;
      }

      const form = document.getElementById("confirmForm");
      const fractionInput = document.getElementById("confirmFractionInput");
      const editorContainer = document.getElementById("confirmJustificationEditor");
      const justificationInput = document.getElementById("confirmJustificationInput");

      const quill = new Quill(editorContainer, {
        theme: "snow",
        placeholder: "Pega aquí la justificación del clasificador...",
      });

      // Bootstrap manda el boton que abrio el modal en event.relatedTarget —
      // asi un solo modal sirve para cualquier fila, sin duplicar el editor.
      modalEl.addEventListener("show.bs.modal", function (event) {
        const trigger = event.relatedTarget;
        const requestId = trigger.dataset.requestId;

        form.action = "{{ path('classification_confirm', { id: 1 }) }}".replace(/\/1\/confirmar$/, "/" + requestId + "/confirmar");
        fractionInput.value = "";
        quill.setText("");
      });

      form.addEventListener("submit", function () {
        justificationInput.value = quill.getSemanticHTML ? quill.getSemanticHTML() : quill.root.innerHTML;
      });
    });
  </script>
{% endblock %}
