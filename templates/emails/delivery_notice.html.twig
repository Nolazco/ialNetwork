<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Aviso de transporte</title>
</head>
<body style="margin:0; padding:0; background-color:#f4f7f9; font-family: Arial, Helvetica, sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f7f9; padding:24px 0;">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:640px; background-color:#ffffff; border-radius:12px; overflow:hidden;">
          <tr>
            <td style="background-color:#41b6c8; padding:20px 24px;">
              <span style="color:#ffffff; font-size:18px; font-weight:bold;">IAL Network</span>
            </td>
          </tr>
          <tr>
            <td style="padding:24px;">
              <p style="margin:0 0 16px; font-size:16px; color:#212529;">
                Aviso de transporte para el <strong>{{ delivery.date|date('d/m/Y') }}</strong> a las <strong>{{ delivery.hour|date('H:i') }}</strong>.
              </p>

              {% for r in references %}
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size:13px; color:#404040; border:1px solid #e5e9eb; border-radius:8px; margin-bottom:12px;">
                  <tr>
                    <td colspan="2" style="padding:10px 12px; background-color:#f4f7f9; border-bottom:1px solid #e5e9eb;">
                      Pedimento <strong>{{ r.agencyReference }}</strong> — {{ r.companyName }}
                      <div style="color:#909090; margin-top:2px;">
                        Ref. cliente {{ r.clientReference }}
                        {% if r.yard %}
                          &nbsp;·&nbsp; Recinto de carga: <strong style="color:#404040;">{{ r.yard }}</strong>
                        {% endif %}
                      </div>
                    </td>
                  </tr>
                  <tr>
                    <td width="50%" valign="top" style="padding:10px 12px; border-right:1px solid #e5e9eb;">
                      <div style="color:#909090; text-transform:uppercase; font-size:11px; letter-spacing:.03em; margin-bottom:2px;">Se factura a</div>
                      <div><strong>{{ r.billingName }}</strong></div>
                      <div>{{ r.billingAddress }}</div>
                      <div>RFC {{ r.billingRfc }}</div>
                    </td>
                    <td width="50%" valign="top" style="padding:10px 12px;">
                      <div style="color:#909090; text-transform:uppercase; font-size:11px; letter-spacing:.03em; margin-bottom:2px;">Entregar en</div>
                      {% if r.travelsWithConsolidator %}
                        <div><strong>XCF</strong>{% if delivery.xcfFolio %} — Folio {{ delivery.xcfFolio }}{% endif %}</div>
                      {% else %}
                        <div>{{ r.deliveryAddress }}</div>
                      {% endif %}
                      {% if r.deliveryInstructions %}
                        <div style="color:#909090; margin-top:2px;">{{ r.deliveryInstructions }}</div>
                      {% endif %}
                    </td>
                  </tr>
                  {% if r.custodia %}
                    <tr>
                      <td colspan="2" style="padding:10px 12px; border-top:1px solid #e5e9eb; background-color:#fff8e6;">
                        <strong>⚠ El flete va con custodia — {{ r.custodia.name }}.</strong>
                        Se agregó en copia a este correo.
                      </td>
                    </tr>
                  {% endif %}
                </table>
              {% endfor %}

              <table role="presentation" width="100%" cellpadding="8" cellspacing="0" style="font-size:14px; color:#404040;">
                <tr>
                  <td style="color:#909090; width:15%;">Clave SAT</td>
                  <td style="width:35%;"><strong>{{ delivery.claveSat }}</strong></td>
                  <td style="color:#909090; width:15%;">Mercancía</td>
                  <td style="width:35%;"><strong>{{ delivery.descripcion }}</strong></td>
                </tr>
                <tr>
                  <td style="color:#909090;">Embalaje</td>
                  <td><strong>{{ delivery.embalaje }}</strong></td>
                  <td style="color:#909090;">Bultos</td>
                  <td><strong>{{ delivery.bultos }}</strong></td>
                </tr>
                <tr>
                  <td style="color:#909090;">Peso</td>
                  <td><strong>{{ delivery.weightKg }} KG</strong></td>
                  <td style="color:#909090;">Cubicaje</td>
                  <td><strong>{{ delivery.cubicaje }} m³</strong></td>
                </tr>
                {% if delivery.containers|length %}
                  <tr>
                    <td style="color:#909090;">Contenedor{{ delivery.containers|length > 1 ? 'es' : '' }}</td>
                    <td colspan="3"><strong>{{ delivery.containers|map(c => c.num ~ ' (' ~ c.type ~ ')')|join(', ') }}</strong></td>
                  </tr>
                {% endif %}
              </table>
              {% if delivery.maniobraRoute %}
                <p style="margin:24px 0 0; font-size:13px; color:#909090;">
                  Se adjunta la maniobra.
                </p>
              {% endif %}
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
