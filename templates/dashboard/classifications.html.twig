{% extends '/dashboard/baseDashboard.html.twig' %}

{% block title %}Clasificaciones{% endblock %}

{% block body %}
  <div class="content">

    <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-2">
      <h2 class="mb-0">Clasificaciones</h2>
      <a href="{{ path('classification_new') }}" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Nueva solicitud
      </a>
    </div>

    <form method="GET" action="{{ path('classifications') }}" class="mb-4">
      <div class="input-group" style="max-width: 480px;">
        <span class="input-group-text"><i class="bi bi-search"></i></span>
        <input type="text" class="form-control" name="q" value="{{ q }}"
               placeholder="Buscar por mercancía, nombre químico, CAS o fracción...">
        {% if q %}
          <a href="{{ path('classifications') }}" class="btn btn-outline-secondary" title="Quitar búsqueda">
            <i class="bi bi-x-lg"></i>
          </a>
        {% endif %}
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
      </div>
    </form>

    {% if requests %}
      <table class="table table-striped align-middle">
        <thead>
          <tr>
            <th scope="col">Fecha</th>
            <th scope="col">Empresa</th>
            <th scope="col">Mercancía</th>
            <th scope="col">Solicitante</th>
            <th scope="col">Fracción arancelaria</th>
            <th scope="col">Archivos</th>
          </tr>
        </thead>
        <tbody>
          {% for r in requests %}
            <tr>
              <td>{{ r.createdAt|date('d/m/Y H:i') }}</td>
              <td>{{ r.company.name }}</td>
              <td>
                {{ r.merchandiseName }}
                {% if r.chemicalName or r.casNumber %}
                  <div class="text-body-secondary small">
                    {{ r.chemicalName }}{% if r.chemicalName and r.casNumber %} · {% endif %}{% if r.casNumber %}CAS {{ r.casNumber }}{% endif %}
                  </div>
                {% endif %}
              </td>
              <td>{{ r.requestedBy.name }}</td>
              <td>
                {% if r.isConfirmed %}
                  <span class="badge text-bg-success">{{ r.confirmedTariffFraction }}</span>
                  <div class="text-body-secondary small">{{ r.confirmedBy.name }} · {{ r.confirmedAt|date('d/m/Y') }}</div>
                {% elseif is_granted('ROLE_EXECUTIVE') %}
                  <form method="POST" action="{{ path('classification_confirm', { id: r.id }) }}" class="d-flex gap-1">
                    <input type="hidden" name="_token" value="{{ csrf_token('classification_confirm') }}">
                    <input type="text" name="confirmedTariffFraction" class="form-control form-control-sm"
                           placeholder="8471.30.01.99" title="Fracción a 10 dígitos: XXXX.XX.XX.XX"
                           pattern="\d{4}\.\d{2}\.\d{2}\.\d{2}" style="width: 170px;" required>
                    <button type="submit" class="btn btn-sm btn-outline-primary">Confirmar</button>
                  </form>
                {% else %}
                  <span class="badge text-bg-warning">Pendiente</span>
                {% endif %}
              </td>
              <td>
                {% if r.attachments|length %}
                  <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#docsModal{{ r.id }}">
                    <i class="bi bi-folder2-open"></i> Ver documentos ({{ r.attachments|length }})
                  </button>
                {% else %}
                  <span class="text-body-secondary">Sin documentos</span>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>

      {% for r in requests %}
        {% if r.attachments|length %}
          <div class="modal fade" id="docsModal{{ r.id }}" tabindex="-1" aria-labelledby="docsModalLabel{{ r.id }}" aria-hidden="true">
            <div class="modal-dialog">
              <div class="modal-content">
                <div class="modal-header">
                  <h5 class="modal-title" id="docsModalLabel{{ r.id }}">Documentos · {{ r.merchandiseName }}</h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                  <ul class="list-group mb-3">
                    {% for a in r.attachments %}
                      <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                        <span class="text-truncate"><i class="bi bi-file-earmark"></i> {{ a.nombre }}</span>
                        <a href="{{ path('classification_attachment_download', { id: r.id, index: loop.index0 }) }}" class="btn btn-sm btn-outline-primary flex-shrink-0" download title="Descargar {{ a.nombre }}">
                          <i class="bi bi-download"></i>
                        </a>
                      </li>
                    {% endfor %}
                  </ul>
                  <a href="{{ path('classification_attachments_zip', { id: r.id }) }}" class="btn btn-primary w-100">
                    <i class="bi bi-file-earmark-zip"></i> Descargar todo (ZIP)
                  </a>
                </div>
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    {% elseif q %}
      <div class="card text-center">
        <div class="card-header">Aviso</div>
        <div class="card-body">
          <h5 class="card-title">Sin resultados</h5>
          <p class="card-text">Nada coincide con "{{ q }}".</p>
        </div>
        <div class="card-footer text-body-secondary"></div>
      </div>
    {% else %}
      <div class="card text-center">
        <div class="card-header">Aviso</div>
        <div class="card-body">
          <h5 class="card-title">Sin registros</h5>
          <p class="card-text">Todavía no se solicita ninguna clasificación.</p>
          <a href="{{ path('classification_new') }}" class="btn btn-primary">Nueva solicitud</a>
        </div>
        <div class="card-footer text-body-secondary"></div>
      </div>
    {% endif %}

  </div>
{% endblock %}
