{% extends '/dashboard/baseDashboard.html.twig' %}

{% block title %}Instrucciones a XCF · {{ import.clientReference }}{% endblock %}

{% block body %}
  <div class="content">

    <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-2">
      <div>
        <h2 class="mb-1">Instrucciones al consolidador de carga (XCF)</h2>
        <p class="text-body-secondary mb-0">
          {{ import.clientReference }} &middot; {{ import.idCompany.name }}
        </p>
      </div>
      <a href="{{ path('case_file', { id: import.id }) }}" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Volver al expediente
      </a>
    </div>

    {% if not import.tariffFraction %}
      <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle"></i>
        Falta la fracción arancelaria — captúrala en «Alta del pedimento» antes de mandar las instrucciones.
      </div>
    {% endif %}

    <form method="POST" action="{{ path('consolidator_instruction_create', { id: import.id }) }}">
      <input type="hidden" name="_token" value="{{ csrf_token('consolidator_instruction_create') }}">

      {# ---------- Destinatario ---------- #}
      <div class="card shadow-sm mb-4">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="card-title mb-0">Destinatario</h5>
            <button type="button" class="btn btn-link btn-sm p-0" id="toggle-new-delivery-point">
              <i class="bi bi-plus-lg"></i> Nuevo destinatario
            </button>
          </div>

          <select class="form-select mb-3" name="deliveryPointId" id="deliveryPointId" required>
            <option value="" selected disabled>Seleccione un destinatario</option>
            <option value="fiscal">Domicilio fiscal ({{ import.idCompany.name }})</option>
            {% for p in deliveryPoints %}
              <option value="{{ p.id }}">{{ p.name }}</option>
            {% endfor %}
          </select>

          <div id="new-delivery-point-fields" class="d-none border rounded p-3">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label">Nombre</label>
                <input type="text" class="form-control" name="newDeliveryPointName">
              </div>
              <div class="col-md-6">
                <label class="form-label">RFC</label>
                <input type="text" class="form-control" name="newDeliveryPointRfc">
              </div>
              <div class="col-md-8">
                <label class="form-label">Calle</label>
                <input type="text" class="form-control" name="newDeliveryPointStreet">
              </div>
              <div class="col-md-2">
                <label class="form-label">Núm ext</label>
                <input type="text" class="form-control" name="newDeliveryPointExtNumber">
              </div>
              <div class="col-md-2">
                <label class="form-label">Núm int</label>
                <input type="text" class="form-control" name="newDeliveryPointIntNumber">
              </div>
              <div class="col-md-4">
                <label class="form-label">Colonia</label>
                <input type="text" class="form-control" name="newDeliveryPointNeighborhood">
              </div>
              <div class="col-md-4">
                <label class="form-label">Localidad</label>
                <input type="text" class="form-control" name="newDeliveryPointLocality">
              </div>
              <div class="col-md-4">
                <label class="form-label">Municipio</label>
                <input type="text" class="form-control" name="newDeliveryPointMunicipality">
              </div>
              <div class="col-md-4">
                <label class="form-label">Estado</label>
                <input type="text" class="form-control" name="newDeliveryPointState">
              </div>
              <div class="col-md-4">
                <label class="form-label">País</label>
                <input type="text" class="form-control" name="newDeliveryPointCountry" value="MEXICO">
              </div>
              <div class="col-md-4">
                <label class="form-label">Código postal</label>
                <input type="text" class="form-control" name="newDeliveryPointZipCode">
              </div>
              <div class="col-md-4">
                <label class="form-label">Contacto</label>
                <input type="text" class="form-control" name="newDeliveryPointContactName">
              </div>
              <div class="col-md-4">
                <label class="form-label">Teléfono</label>
                <input type="text" class="form-control" name="newDeliveryPointContactPhone">
              </div>
              <div class="col-md-4">
                <label class="form-label">Correo</label>
                <input type="email" class="form-control" name="newDeliveryPointContactEmail">
              </div>
            </div>
          </div>

          <hr>

          <label for="deliveryDate" class="form-label">Fecha estimada de entrega en XCF (opcional)</label>
          <input type="date" class="form-control" name="deliveryDate" id="deliveryDate" style="max-width: 220px;">
          <div class="form-text">Se puede mandar la instrucción sin tener todavía la cita; es solo para que XCF se vaya organizando.</div>
        </div>
      </div>

      {# ---------- Mercancía ---------- #}
      <div class="card shadow-sm mb-4">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="card-title mb-0">Mercancía</h5>
            <button type="button" class="btn btn-link btn-sm p-0" id="toggle-new-merchandise">
              <i class="bi bi-plus-lg"></i> Nueva mercancía
            </button>
          </div>

          <select class="form-select mb-3" name="merchandiseProfileId" id="merchandiseProfileId" required>
            <option value="" selected disabled>Seleccione la mercancía</option>
            {% for m in merchandiseProfiles %}
              <option value="{{ m.id }}">{{ m.descripcion }}</option>
            {% endfor %}
          </select>

          <div id="new-merchandise-fields" class="d-none border rounded p-3 mb-3">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label">Descripción</label>
                <input type="text" class="form-control" name="descripcion" value="{{ import.goods }}">
              </div>
              <div class="col-md-3">
                <label class="form-label">Clave de bienes (SAT)</label>
                <input type="text" class="form-control" name="claveSat">
              </div>
              <div class="col-md-3">
                <label class="form-label">Clave de unidad</label>
                <input type="text" class="form-control" name="claveUnidad">
              </div>
              <div class="col-md-4">
                <label class="form-label">Unidad</label>
                <input type="text" class="form-control" name="unidad" placeholder="Ej. CUÑETES">
              </div>
              <div class="col-md-4 d-flex align-items-end">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" value="1" name="estibable" id="estibable">
                  <label class="form-check-label" for="estibable">Estibable</label>
                </div>
              </div>
              <div class="col-md-4 d-flex align-items-end">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" value="1" name="saveMerchandiseProfile" id="saveMerchandiseProfile" checked>
                  <label class="form-check-label" for="saveMerchandiseProfile">Guardar para reutilizar</label>
                </div>
              </div>
            </div>
          </div>

          <div class="row g-3">
            <div class="col-md-3">
              <label for="quantity" class="form-label">Cantidad</label>
              <input type="number" min="1" class="form-control" name="quantity" id="quantity" required>
            </div>
            <div class="col-md-3">
              <label for="weightKg" class="form-label">Peso (KG)</label>
              <input type="number" min="0" step="0.01" class="form-control" name="weightKg" id="weightKg" required>
            </div>
          </div>
        </div>
      </div>

      {# ---------- Transporte ---------- #}
      <div class="card shadow-sm mb-4">
        <div class="card-body">
          <h5 class="card-title mb-3">Transporte</h5>
          <label for="transportId" class="form-label">Transportista que se presentará en XCF</label>
          <select class="form-select" name="transportId" id="transportId" required>
            <option value="" selected disabled>Seleccione el transportista</option>
            {% for h in haulers %}
              <option value="{{ h.id }}">{{ h.companyName }} (CAAT {{ h.caat }})</option>
            {% endfor %}
          </select>
          <div class="form-text">XCF no deja pasar a nadie que no venga en el correo de instrucciones.</div>
        </div>
      </div>

      {# ---------- Cobrar a ---------- #}
      <div class="card shadow-sm mb-4">
        <div class="card-body">
          <div class="form-check">
            <input class="form-check-input" type="checkbox" value="1" name="billedToClient" id="billedToClient">
            <label class="form-check-label" for="billedToClient">
              El cliente paga el flete directamente (si no, se deja como en la plantilla)
            </label>
          </div>
        </div>
      </div>

      <button type="submit" class="btn btn-primary" {{ import.tariffFraction ? '' : 'disabled' }}>
        <i class="bi bi-envelope"></i> Generar y enviar a XCF
      </button>

      {% if app.environment != 'prod' %}
        {# Botón de pruebas: manda solo a ConsolidatorMailer::TEST_RECIPIENT,
           sin guardar nada ni tocar los correos de /admin. Quitar este botón
           (y ConsolidatorMailer::TEST_RECIPIENT / DashboardConsolidatorInstructions::create
           testMode) antes de producción. #}
        <button type="submit" name="testMode" value="1" class="btn btn-outline-secondary" {{ import.tariffFraction ? '' : 'disabled' }}>
          <i class="bi bi-flask"></i> Prueba XCF (solo a {{ testRecipient }})
        </button>
      {% endif %}
    </form>

  </div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const deliveryPointSelect = document.getElementById("deliveryPointId");
      const toggleDeliveryPointBtn = document.getElementById("toggle-new-delivery-point");
      const newDeliveryPointFields = document.getElementById("new-delivery-point-fields");
      let creatingDeliveryPoint = false;

      toggleDeliveryPointBtn.addEventListener("click", function () {
        creatingDeliveryPoint = !creatingDeliveryPoint;

        deliveryPointSelect.classList.toggle("d-none", creatingDeliveryPoint);
        deliveryPointSelect.required = !creatingDeliveryPoint;
        deliveryPointSelect.value = "";

        newDeliveryPointFields.classList.toggle("d-none", !creatingDeliveryPoint);
        newDeliveryPointFields.querySelectorAll("input").forEach(function (input) {
          if (input.name !== "newDeliveryPointCountry") {
            input.value = "";
          }
        });

        toggleDeliveryPointBtn.innerHTML = creatingDeliveryPoint
          ? '<i class="bi bi-list"></i> Elegir del catálogo'
          : '<i class="bi bi-plus-lg"></i> Nuevo destinatario';
      });

      const merchandiseSelect = document.getElementById("merchandiseProfileId");
      const toggleMerchandiseBtn = document.getElementById("toggle-new-merchandise");
      const newMerchandiseFields = document.getElementById("new-merchandise-fields");
      let creatingMerchandise = false;

      toggleMerchandiseBtn.addEventListener("click", function () {
        creatingMerchandise = !creatingMerchandise;

        merchandiseSelect.classList.toggle("d-none", creatingMerchandise);
        merchandiseSelect.required = !creatingMerchandise;
        merchandiseSelect.value = "";

        newMerchandiseFields.classList.toggle("d-none", !creatingMerchandise);
        newMerchandiseFields.querySelectorAll("input[type=text]").forEach(function (input) {
          if (input.name !== "descripcion") {
            input.value = "";
          }
        });

        toggleMerchandiseBtn.innerHTML = creatingMerchandise
          ? '<i class="bi bi-list"></i> Elegir del catálogo'
          : '<i class="bi bi-plus-lg"></i> Nueva mercancía';
      });
    });
  </script>
{% endblock %}
