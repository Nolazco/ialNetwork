{% extends '/dashboard/baseDashboard.html.twig' %}

{% block title %}Nueva solicitud de clasificación{% endblock %}

{% block body %}
  <div class="content">

    <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-2">
      <h2 class="mb-0">Solicitud de clasificación</h2>
      <a href="{{ path('classifications') }}" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Volver
      </a>
    </div>

    {% if companies is empty %}
      <div class="alert alert-warning">
        No tienes ninguna empresa afiliada y aprobada todavía. Afíliate a una empresa antes de solicitar una clasificación.
      </div>
    {% else %}
      <div class="card shadow-sm mb-4">
        <div class="card-body">
          <h5 class="card-title">¿Ya se clasificó algo similar?</h5>
          <p class="text-body-secondary small mb-3">
            Busca por nombre comercial, nombre químico o número de CAS antes de mandar una solicitud nueva: si ya existe, ahórrate el trámite con el clasificador.
          </p>
          <input type="text" class="form-control" id="priorSearch" placeholder="Escribe al menos 3 letras...">
          <div id="priorSearchResults" class="mt-2"></div>
        </div>
      </div>

      <form method="POST" enctype="multipart/form-data" action="{{ path('classification_create') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('classification_create') }}">

        <div class="card shadow-sm mb-4">
          <div class="card-body">
            <p class="mb-3 text-body-secondary">Solicitando como: <strong>{{ name }} ({{ app.user.email }})</strong></p>

            <div class="row g-3">
              <div class="col-md-6">
                <label for="company" class="form-label">Empresa</label>
                <select class="form-select" name="company" id="company" required>
                  <option value="" selected disabled>Selecciona una empresa</option>
                  {% for c in companies %}
                    <option value="{{ c.id }}">{{ c.name }} ({{ c.rfc }})</option>
                  {% endfor %}
                </select>
              </div>
              <div class="col-md-6">
                <label for="merchandiseName" class="form-label">Nombre comercial de la mercancía</label>
                <input type="text" class="form-control" name="merchandiseName" id="merchandiseName" placeholder="Paracetamol, Ibuprofen, etc..." required>
              </div>

              <div class="col-md-6">
                <label for="chemicalName" class="form-label">Nombre químico (opcional)</label>
                <input type="text" class="form-control" name="chemicalName" id="chemicalName" placeholder="4-Acetamidophenol">
              </div>
              <div class="col-md-6">
                <label for="casNumber" class="form-label">Número de CAS (opcional)</label>
                <input type="text" class="form-control" name="casNumber" id="casNumber" placeholder="XXX-XX-X">
              </div>

              <div class="col-md-6">
                <label for="merchandiseUse" class="form-label">Uso de la mercancía</label>
                <input type="text" class="form-control" name="merchandiseUse" id="merchandiseUse" placeholder="Humano, Veterinario, Plaguicida" required>
              </div>
              <div class="col-md-6">
                <label for="presentation" class="form-label">Presentación de la mercancía</label>
                <input type="text" class="form-control" name="presentation" id="presentation" placeholder="Polvo, Granular, Tabletas" required>
              </div>

              <div class="col-12">
                <label class="form-label">Archivos (COA, MSDS, cualquier archivo que consideres necesario)</label>
                <div class="file-drop-area">
                  <input type="file" name="documents[]" id="documents" multiple required
                         class="position-absolute top-0 start-0 w-100 h-100" style="opacity: 0;">
                  <div class="file-drop-hint">
                    <i class="bi bi-cloud-arrow-up"></i>
                    Arrastra y suelta archivos aquí, o haz clic para elegir archivos.
                  </div>
                </div>
                <ul class="list-group file-drop-list" id="documents-list"></ul>
                <div class="form-text">Permitidos: {{ allowedExtensions|join(', ') }}.</div>
              </div>
            </div>
          </div>
        </div>

        <button type="submit" class="btn btn-primary">
          <i class="bi bi-send"></i> Enviar solicitud
        </button>
      </form>
    {% endif %}

  </div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      initMultiFileInput({ inputId: "documents", listId: "documents-list" });

      const input = document.getElementById("priorSearch");
      const results = document.getElementById("priorSearchResults");

      if (!input) {
        return;
      }

      let timer = null;

      input.addEventListener("input", function () {
        clearTimeout(timer);
        const q = input.value.trim();

        if (q.length < 3) {
          results.innerHTML = "";
          return;
        }

        timer = setTimeout(function () {
          fetch("{{ path('classification_search') }}?q=" + encodeURIComponent(q))
            .then(function (r) { return r.json(); })
            .then(function (data) { renderResults(data.results); })
            .catch(function () { results.innerHTML = ""; });
        }, 300);
      });

      function renderResults(items) {
        if (!items.length) {
          results.innerHTML = '<p class="text-body-secondary small mb-0">Sin coincidencias.</p>';
          return;
        }

        results.innerHTML = '<ul class="list-group"></ul>';
        const list = results.querySelector("ul");

        items.forEach(function (item) {
          const li = document.createElement("li");
          li.className = "list-group-item d-flex justify-content-between align-items-start flex-wrap gap-2";

          const info = document.createElement("div");

          const name = document.createElement("strong");
          name.textContent = item.merchandiseName;
          info.appendChild(name);

          const details = [item.chemicalName, item.casNumber ? "CAS " + item.casNumber : null].filter(Boolean).join(" · ");
          if (details) {
            const detailsLine = document.createElement("div");
            detailsLine.className = "text-body-secondary small";
            detailsLine.textContent = details;
            info.appendChild(detailsLine);
          }

          const metaLine = document.createElement("div");
          metaLine.className = "text-body-secondary small";
          metaLine.textContent = item.company + " · " + item.createdAt;
          info.appendChild(metaLine);

          const badge = document.createElement("span");
          badge.className = "badge " + (item.confirmedTariffFraction ? "text-bg-success" : "text-bg-warning") + " align-self-center";
          badge.textContent = item.confirmedTariffFraction || "Pendiente";

          li.appendChild(info);
          li.appendChild(badge);
          list.appendChild(li);
        });
      }
    });
  </script>
{% endblock %}
