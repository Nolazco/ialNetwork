{% extends '/dashboard/baseDashboard.html.twig' %}
{% block body %}
	<!-- Contenido principal -->
  <div class="content">
    <form action="/dashboard/pedimentos/{{ rfc }}/new" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="_token" value="{{ csrf_token('create_import') }}">
      <div class="row">
        <div class="col">
          <label for="ref" class="form-label">Referencia</label>
          <input type="text" class="form-control" id="ref" name="ref" placeholder="Referencia" required>
        </div>
        <div class="col">
          <label for="goods" class="form-label">Mercancía</label>
          <input type="text" class="form-control" name="goods" id="goods" placeholder="Mercancía" required>
        </div>
      </div>
      <div class="row mt-3">
        <div class="col">
          <div class="d-flex justify-content-between align-items-center">
            <label for="provider" class="form-label mb-0">Proveedor</label>
            <button type="button" class="btn btn-link btn-sm p-0" id="toggle-new-provider">
              <i class="bi bi-plus-lg"></i> Nuevo proveedor
            </button>
          </div>
          <select class="form-select" name="provider" id="provider" required>
            <option value="" selected disabled>Seleccione un proveedor</option>
            {% for p in providers %}
              <option value="{{ p.id }}">{{ p.name }}</option>
            {% endfor %}
          </select>
          <div id="new-provider-fields" class="d-none border rounded p-2 mt-2">
            <div class="mb-2">
              <label for="newProviderName" class="form-label small mb-1">Nombre</label>
              <input type="text" class="form-control form-control-sm" id="newProviderName" name="newProviderName" placeholder="Nombre del proveedor">
            </div>
            <div class="mb-2">
              <label for="newProviderTaxId" class="form-label small mb-1">RFC / identificador fiscal</label>
              <input type="text" class="form-control form-control-sm" id="newProviderTaxId" name="newProviderTaxId" placeholder="RFC o tax ID">
            </div>
            <div class="mb-0">
              <label for="newProviderAddress" class="form-label small mb-1">Dirección</label>
              <input type="text" class="form-control form-control-sm" id="newProviderAddress" name="newProviderAddress" placeholder="Dirección">
            </div>
          </div>
        </div>
        <div class="col">
          <label for="eta" class="form-label">Fecha de arribo</label>
          <input type="date" class="form-control" name="eta" id="eta" required>
        </div>
      </div>
      <div class="row mt-3">
        <div class="col">
          <label class="form-label">Consignado a</label>
          <select class="form-select" name="consignedTo" id="consignedTo" required>
            <option value="cliente" selected>Cliente</option>
            <option value="forwarder">Forwarder</option>
          </select>
        </div>
        <div class="col d-none" id="forwarder-wrapper">
          <div class="d-flex justify-content-between align-items-center">
            <label for="forwarderId" class="form-label mb-0">Forwarder</label>
            <button type="button" class="btn btn-link btn-sm p-0" id="toggle-new-forwarder">
              <i class="bi bi-plus-lg"></i> Nuevo forwarder
            </button>
          </div>
          <select class="form-select" name="forwarderId" id="forwarderId">
            <option value="" selected disabled>Seleccione un forwarder</option>
            {% for f in forwarders %}
              <option value="{{ f.id }}">{{ f.name }}</option>
            {% endfor %}
          </select>
          <div id="new-forwarder-fields" class="d-none border rounded p-2 mt-2">
            <div class="mb-2">
              <label for="newForwarderName" class="form-label small mb-1">Nombre</label>
              <input type="text" class="form-control form-control-sm" id="newForwarderName" name="newForwarderName" placeholder="Nombre del forwarder">
            </div>
            <div class="mb-0">
              <label for="newForwarderEmails" class="form-label small mb-1">Correos de contacto</label>
              <input type="text" class="form-control form-control-sm" id="newForwarderEmails" name="newForwarderEmails" placeholder="correo1@forwarder.com; correo2@forwarder.com">
              <div class="form-text small">Puedes capturar varios, separados por punto y coma.</div>
            </div>
          </div>
        </div>
      </div>
      <div class="row mt-3">
        <div class="col">
          <label for="direction" class="form-label">Operación</label>
          <select class="form-select" name="direction" id="direction" required>
            <option selected disabled value="">Seleccione la operación</option>
            {% for value, label in directions %}
              <option value="{{ value }}">{{ label }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="col">
          <label for="type" class="form-label">Tipo de carga</label>
          <select class="form-select" name="type" id="type" required>
            <option selected disabled value="">Seleccione el tipo de carga</option>
            {% for value, label in types %}
              <option value="{{ value }}">{{ label }}</option>
            {% endfor %}
          </select>
        </div>
      </div>
      <p class="text-body-secondary small mt-2 mb-0">
        <i class="bi bi-info-circle"></i>
        El recinto lo asigna la agencia al dar de alta el pedimento.
      </p>
      <div class="row mt-3">
        <div class="col">
          <label class="form-label">Entregar en</label>
          <select class="form-select" name="deliverTo" id="deliverTo" required>
            <option value="fiscal" selected>Domicilio fiscal</option>
            <option value="point">Punto de entrega</option>
          </select>
        </div>
        <div class="col d-none" id="delivery-point-wrapper">
          <div class="d-flex justify-content-between align-items-center">
            <label for="deliveryPointId" class="form-label mb-0">Punto de entrega</label>
            <button type="button" class="btn btn-link btn-sm p-0" id="toggle-new-delivery-point">
              <i class="bi bi-plus-lg"></i> Nuevo punto
            </button>
          </div>
          <select class="form-select" name="deliveryPointId" id="deliveryPointId">
            <option value="" selected disabled>Seleccione un punto de entrega</option>
            {% for p in deliveryPoints %}
              <option value="{{ p.id }}">{{ p.name }}</option>
            {% endfor %}
          </select>
          <div id="new-delivery-point-fields" class="d-none border rounded p-2 mt-2">
            <div class="mb-2">
              <label for="newDeliveryPointName" class="form-label small mb-1">Nombre</label>
              <input type="text" class="form-control form-control-sm" id="newDeliveryPointName" name="newDeliveryPointName" placeholder="Ej. Almacén Norte">
            </div>
            <div class="mb-0">
              <label for="newDeliveryPointAddress" class="form-label small mb-1">Dirección</label>
              <input type="text" class="form-control form-control-sm" id="newDeliveryPointAddress" name="newDeliveryPointAddress" placeholder="Dirección">
            </div>
          </div>
        </div>
      </div>
      <div class="row mt-3">
        <div class="col">
          <label for="deliveryInstructions" class="form-label">Instrucciones de entrega (opcional)</label>
          <textarea class="form-control" name="deliveryInstructions" id="deliveryInstructions" rows="2" placeholder="Ej. Entregar 20 bultos en Almacén A y el resto en Almacén B"></textarea>
        </div>
      </div>
      <div class="row mt-3">
        <div class="col">
          <label for="inspectionAuthority" class="form-label">¿Requiere inspección?</label>
          <select class="form-select" name="inspectionAuthority" id="inspectionAuthority" required>
            <option selected disabled value="">Seleccione una opción</option>
            <option value="{{ inspectionNone }}">{{ inspectionNone }}</option>
            {% for a in inspectionAuthorities %}
              <option value="{{ a }}">{{ a }}</option>
            {% endfor %}
            <option value="{{ inspectionOther }}">Otra autoridad (especificar)…</option>
            <option value="{{ inspectionUnsure }}">{{ inspectionUnsure }}</option>
          </select>
        </div>
        <div class="col d-none" id="custom-inspection-wrapper">
          <label for="customInspectionAuthority" class="form-label">¿Cuál autoridad?</label>
          <input type="text" class="form-control" name="customInspectionAuthority" id="customInspectionAuthority" placeholder="Nombre de la autoridad">
        </div>
      </div>
      <div id="container-fields-wrapper" style="display: none;">
        <label class="form-label mt-3">Contenedores</label>
        <div id="container-fields">
          <div class="row container-row align-items-end mb-2">
            <div class="col">
              <input type="text" class="form-control" name="containers[]" placeholder="Numero de contenedor">
            </div>
            <div class="col">
              <select class="form-select" name="contTypes[]">
                <option selected disabled>Seleccione el tipo de contenedor</option>
                <option value="20DC">20 pies estandar</option>
                <option value="20HC">20 pies cubo alto</option>
                <option value="40DC">40 pies estandar</option>
                <option value="40HC">40 pies cubo alto</option>
                <option value="40RH">40 pies refrigerado</option>
              </select>
            </div>
            <div class="col-auto">
              <button type="button" class="btn btn-outline-danger delete-container-btn" title="Eliminar">
                <i class="bi bi-trash"></i>
              </button>
            </div>
          </div>
        </div>
        <button type="button" class="btn btn-outline-primary mt-2" id="add-container-btn">
          <i class="bi bi-plus"></i> Agregar contenedor
        </button>
      </div>

      <div id="documents-container">
        <div class="row mt-2 document-row align-items-end">
          <div class="col">
            <label class="form-label">Documento</label>
            <input class="form-control file-input" type="file" name="documents[]">
          </div>
          <div class="col">
            <label class="form-label">Tipo de documento</label>
            <input type="text" class="form-control" name="documentTypes[]" required placeholder="Ej. Factura">
          </div>
          <div class="col-auto">
            <button type="button" class="btn btn-outline-danger delete-row-btn" title="Eliminar">
              <i class="bi bi-trash"></i>
            </button>
          </div>
        </div>
      </div>
      <input class="btn btn-primary mt-3" type="submit" name="submit" id="submit" value="Guardar">
    </form>
  </div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const container = document.getElementById("documents-container");

      // Delegar eventos dentro del contenedor
      container.addEventListener("change", function (e) {
        if (e.target && e.target.classList.contains("file-input")) {
          const currentRow = e.target.closest(".document-row");
          const inputs = container.querySelectorAll(".file-input");
          if ([...inputs].filter(input => input.value === "").length === 0) {
            const newRow = currentRow.cloneNode(true);
            newRow.querySelectorAll("input").forEach(input => input.value = "");
            container.appendChild(newRow);
          }
        }
      });

      container.addEventListener("click", function (e) {
        if (e.target.closest(".delete-row-btn")) {
          const row = e.target.closest(".document-row");
          if (container.querySelectorAll(".document-row").length > 1) {
            row.remove();
          } else {
            // Limpiar la fila si es la única
            row.querySelectorAll("input").forEach(input => input.value = "");
          }
        }
      });

      // Alterna entre elegir un proveedor del catalogo o capturar uno nuevo.
      const providerSelect = document.getElementById("provider");
      const toggleProviderBtn = document.getElementById("toggle-new-provider");
      const newProviderFields = document.getElementById("new-provider-fields");
      let creatingProvider = false;

      toggleProviderBtn.addEventListener("click", function () {
        creatingProvider = !creatingProvider;

        providerSelect.classList.toggle("d-none", creatingProvider);
        providerSelect.required = !creatingProvider;
        providerSelect.value = "";

        newProviderFields.classList.toggle("d-none", !creatingProvider);
        newProviderFields.querySelectorAll("input").forEach(function (input) {
          input.required = creatingProvider;
          input.value = "";
        });

        toggleProviderBtn.innerHTML = creatingProvider
          ? '<i class="bi bi-list"></i> Elegir del catálogo'
          : '<i class="bi bi-plus-lg"></i> Nuevo proveedor';
      });

      // Alterna si el embarque viene consignado al cliente o a un forwarder,
      // y dentro de forwarder, entre elegir uno del catalogo o capturar uno
      // nuevo (mismo mecanismo que el bloque de proveedor de arriba).
      const consignedToSelect = document.getElementById("consignedTo");
      const forwarderWrapper = document.getElementById("forwarder-wrapper");
      const forwarderSelect = document.getElementById("forwarderId");
      const toggleForwarderBtn = document.getElementById("toggle-new-forwarder");
      const newForwarderFields = document.getElementById("new-forwarder-fields");
      let creatingForwarder = false;

      function toggleForwarderVisibility() {
        const showForwarder = consignedToSelect.value === "forwarder";
        forwarderWrapper.classList.toggle("d-none", !showForwarder);
        forwarderSelect.required = showForwarder && !creatingForwarder;

        if (!showForwarder) {
          creatingForwarder = false;
          forwarderSelect.classList.remove("d-none");
          forwarderSelect.value = "";
          newForwarderFields.classList.add("d-none");
          newForwarderFields.querySelectorAll("input").forEach(function (input) {
            input.required = false;
            input.value = "";
          });
          toggleForwarderBtn.innerHTML = '<i class="bi bi-plus-lg"></i> Nuevo forwarder';
        }
      }

      consignedToSelect.addEventListener("change", toggleForwarderVisibility);
      toggleForwarderVisibility();

      toggleForwarderBtn.addEventListener("click", function () {
        creatingForwarder = !creatingForwarder;

        forwarderSelect.classList.toggle("d-none", creatingForwarder);
        forwarderSelect.required = !creatingForwarder;
        forwarderSelect.value = "";

        newForwarderFields.classList.toggle("d-none", !creatingForwarder);
        newForwarderFields.querySelectorAll("input").forEach(function (input) {
          input.required = creatingForwarder;
          input.value = "";
        });

        toggleForwarderBtn.innerHTML = creatingForwarder
          ? '<i class="bi bi-list"></i> Elegir del catálogo'
          : '<i class="bi bi-plus-lg"></i> Nuevo forwarder';
      });

      // Igual que el bloque de forwarder: domicilio fiscal vs punto de
      // entrega del catalogo, y dentro de este ultimo, elegir uno existente
      // o capturar uno nuevo.
      const deliverToSelect = document.getElementById("deliverTo");
      const deliveryPointWrapper = document.getElementById("delivery-point-wrapper");
      const deliveryPointSelect = document.getElementById("deliveryPointId");
      const toggleDeliveryPointBtn = document.getElementById("toggle-new-delivery-point");
      const newDeliveryPointFields = document.getElementById("new-delivery-point-fields");
      let creatingDeliveryPoint = false;

      function toggleDeliveryPointVisibility() {
        const showPoint = deliverToSelect.value === "point";
        deliveryPointWrapper.classList.toggle("d-none", !showPoint);
        deliveryPointSelect.required = showPoint && !creatingDeliveryPoint;

        if (!showPoint) {
          creatingDeliveryPoint = false;
          deliveryPointSelect.classList.remove("d-none");
          deliveryPointSelect.value = "";
          newDeliveryPointFields.classList.add("d-none");
          newDeliveryPointFields.querySelectorAll("input").forEach(function (input) {
            input.required = false;
            input.value = "";
          });
          toggleDeliveryPointBtn.innerHTML = '<i class="bi bi-plus-lg"></i> Nuevo punto';
        }
      }

      deliverToSelect.addEventListener("change", toggleDeliveryPointVisibility);
      toggleDeliveryPointVisibility();

      toggleDeliveryPointBtn.addEventListener("click", function () {
        creatingDeliveryPoint = !creatingDeliveryPoint;

        deliveryPointSelect.classList.toggle("d-none", creatingDeliveryPoint);
        deliveryPointSelect.required = !creatingDeliveryPoint;
        deliveryPointSelect.value = "";

        newDeliveryPointFields.classList.toggle("d-none", !creatingDeliveryPoint);
        newDeliveryPointFields.querySelectorAll("input").forEach(function (input) {
          input.required = creatingDeliveryPoint;
          input.value = "";
        });

        toggleDeliveryPointBtn.innerHTML = creatingDeliveryPoint
          ? '<i class="bi bi-list"></i> Elegir del catálogo'
          : '<i class="bi bi-plus-lg"></i> Nuevo punto';
      });

      // El campo libre solo aparece cuando la autoridad no esta en el catalogo.
      const inspectionSelect = document.getElementById("inspectionAuthority");
      const inspectionWrapper = document.getElementById("custom-inspection-wrapper");
      const inspectionCustom = document.getElementById("customInspectionAuthority");

      inspectionSelect.addEventListener("change", function () {
        const isOther = inspectionSelect.value === {{ inspectionOther|json_encode|raw }};
        inspectionWrapper.classList.toggle("d-none", !isOther);
        inspectionCustom.required = isOther;
        if (!isOther) {
          inspectionCustom.value = "";
        }
      });

      const typeSelect = document.getElementById("type");
      const containerFieldsWrapper = document.getElementById("container-fields-wrapper");
      const containerFields = document.getElementById("container-fields");
      const addContainerBtn = document.getElementById("add-container-btn");

      function toggleContainerFields() {
        const isContainer = typeSelect.value === "container";
        containerFieldsWrapper.style.display = isContainer ? "block" : "none";
            
        containerFields.querySelectorAll("input, select").forEach(el => el.required = isContainer);
      }

      typeSelect.addEventListener("change", toggleContainerFields);
      toggleContainerFields(); // Por si hay valor cargado

      addContainerBtn.addEventListener("click", () => {
        const lastRow = containerFields.querySelector(".container-row");
        const newRow = lastRow.cloneNode(true);

        newRow.querySelectorAll("input, select").forEach(el => el.value = "");
        containerFields.appendChild(newRow);
      });

      containerFields.addEventListener("click", function (e) {
        if (e.target.closest(".delete-container-btn")) {
          const allRows = containerFields.querySelectorAll(".container-row");
          if (allRows.length > 1) {
            e.target.closest(".container-row").remove();
          } else {
            e.target.closest(".container-row").querySelectorAll("input, select").forEach(el => el.value = "");
          }
        }
      });
    });
  </script>
{% endblock %}