{% extends 'base.html.twig' %}

{#
  Portada, una sola plantilla para los dos idiomas.

  Antes habia un archivo por idioma (indexEs / indexEn) con el mismo marcado
  duplicado: cualquier cambio de maquetacion habia que hacerlo dos veces y era
  facil que uno de los dos se quedara atras. Ahora el texto sale de
  translations/messages.{es,en}.yaml y el idioma lo fija la ruta.

  Las rutas de los assets son absolutas (/index/...) a proposito: las relativas
  obligaban a escribir ./index/ en la version española y ./../index/ en la
  inglesa, porque /en cuelga un nivel mas abajo.
#}

{% block stylesheets %}
	{{ encore_entry_link_tags('app') }}
	<link rel="stylesheet" href="/index/css/bootstrap.min.css">
	<link rel="stylesheet" href="/index/css/font-awesome.min.css">
	<link rel="stylesheet" href="/index/css/aos.css">
	<!-- MAIN CSS -->
	<link rel="stylesheet" href="/index/css/tooplate-gymso-style.css">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/flag-icon-css/3.5.0/css/flag-icon.min.css">
{% endblock %}

{% block body %}
	{% set locale = app.request.locale %}

	<!-- MENU BAR -->
	<nav class="navbar navbar-expand-lg fixed-top">
		<div class="container">
			<a class="navbar-brand" href="{{ path('index') }}">
				<img width="auto" height="50" src="/index/img/IAL_NETWORK_logo.png" alt="Logo IAL Network">
			</a>

			<button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav"
				aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
				<span class="navbar-toggler-icon"></span>
			</button>

			<div class="collapse navbar-collapse" id="navbarNav">
				<ul class="navbar-nav ml-lg-auto">
					<li class="nav-item">
						<a href="#home" class="nav-link smoothScroll">{{ 'landing.nav.home'|trans }}</a>
					</li>
					<li class="nav-item">
						<a href="#about" class="nav-link smoothScroll">{{ 'landing.nav.about'|trans }}</a>
					</li>
					<li class="nav-item">
						<a href="#class" class="nav-link smoothScroll">{{ 'landing.nav.services'|trans }}</a>
					</li>
					<li class="nav-item">
						<a href="#contact" class="nav-link smoothScroll">{{ 'landing.nav.contact'|trans }}</a>
					</li>
				</ul>

				{# Selector de idioma: la bandera del boton es la del idioma activo y
				   cada opcion apunta a su propia ruta. #}
				<ul class="social-icon ml-lg-3">
					<li>
						<div class="dropdown">
							<button class="btn text-white dropdown-toggle" type="button" id="languageMenuButton"
								data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
								<span class="flag-icon flag-icon-{{ locale == 'en' ? 'us' : 'mx' }}"></span>
							</button>
							<div class="dropdown-menu bg-dark" aria-labelledby="languageMenuButton">
								<a class="dropdown-item{{ locale != 'en' ? ' active' : '' }}" href="{{ path('index') }}">
									<span class="flag-icon flag-icon-mx"></span> ESP
								</a>
								<a class="dropdown-item{{ locale == 'en' ? ' active' : '' }}" href="{{ path('index_en') }}">
									<span class="flag-icon flag-icon-us"></span> ENG
								</a>
							</div>
						</div>
					</li>
				</ul>

				<ul class="social-icon ml-lg-3">
					<li>
						<div class="dropdown">
							{% if app.user %}
								<button class="btn text-white dropdown-toggle" type="button" id="accountMenuButton"
									data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
									<span>
										<i class="bi bi-gear"></i>
										{{ 'landing.account.greeting'|trans({ '%name%': app.user.name }) }}
									</span>
								</button>
								<div class="dropdown-menu bg-dark" aria-labelledby="accountMenuButton">
									<a class="dropdown-item" href="{{ path('dashboard') }}">
										<span>{{ 'landing.account.dashboard'|trans }}</span>
									</a>
									<a class="dropdown-item" href="{{ path('logout') }}">
										<span>{{ 'landing.account.logout'|trans }}</span>
									</a>
								</div>
							{% else %}
								<button class="btn text-white dropdown-toggle" type="button" id="accountMenuButton"
									data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
									<span><i class="bi bi-person"></i></span>
								</button>
								<div class="dropdown-menu bg-dark" aria-labelledby="accountMenuButton">
									<a class="dropdown-item" href="{{ path('login') }}">
										<span>{{ 'landing.account.login'|trans }}</span>
									</a>
									<a class="dropdown-item" href="{{ path('register') }}">
										<span>{{ 'landing.account.register'|trans }}</span>
									</a>
								</div>
							{% endif %}
						</div>
					</li>
				</ul>
			</div>
		</div>
	</nav>

	<!-- HERO -->
	<section class="hero d-flex flex-column justify-content-center align-items-center" id="home">
		<div class="bg-overlay"></div>
		<div class="container">
			<div class="row">
				<div class="col-lg-8 col-md-10 mx-auto col-12">
					<div class="hero-text mt-5 text-center">
						<h6 data-aos="fade-up" data-aos-delay="300">{{ 'landing.hero.tagline'|trans }}</h6>
						<h1 class="text-white" data-aos="fade-up" data-aos-delay="500">{{ 'landing.hero.title'|trans }}</h1>
						<a href="#class" class="btn custom-btn mt-3" data-aos="fade-up"
							data-aos-delay="600">{{ 'landing.nav.services'|trans }}</a>
						<a href="#contact" class="btn custom-btn bordered mt-3" data-aos="fade-up"
							data-aos-delay="700">{{ 'landing.hero.more'|trans }}</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="feature" id="feature">
		<div class="container">
			<div class="row">
				<div class="d-flex flex-column justify-content-center ml-lg-auto mr-lg-5 col-lg-5 col-md-6 col-12">
					<h2 class="mb-3 text-white" data-aos="fade-up">{{ 'landing.feature.question'|trans }}</h2>
					<h6 class="mb-4 text-white" data-aos="fade-up">{{ 'landing.feature.trust'|trans }}</h6>
					<p data-aos="fade-up" data-aos-delay="200">{{ 'landing.feature.experience'|trans }}</p>
					<p data-aos="fade-up" data-aos-delay="300">{{ 'landing.feature.callout'|trans }}</p>
					<a href="#contact" class="btn custom-btn bg-color mt-3" data-aos="fade-up"
						data-aos-delay="300">{{ 'landing.feature.contact_now'|trans }}</a>
				</div>
				<div class="mr-lg-auto mt-3 col-lg-4 col-md-6 col-12">
					<div class="about-working-hours">
						<div>
							<h2 class="mb-4 text-white" data-aos="fade-up"
								data-aos-delay="500">{{ 'landing.feature.hours.title'|trans }}</h2>
							<strong class="mt-3 d-block" data-aos="fade-up"
								data-aos-delay="700">{{ 'landing.feature.hours.weekdays'|trans }}</strong>
							<p data-aos="fade-up" data-aos-delay="800">{{ 'landing.feature.hours.weekdays_time'|trans }}</p>
							<strong class="mt-3 d-block" data-aos="fade-up"
								data-aos-delay="700">{{ 'landing.feature.hours.saturday'|trans }}</strong>
							<p data-aos="fade-up" data-aos-delay="800">{{ 'landing.feature.hours.saturday_time'|trans }}</p>
							<strong class="d-block" data-aos="fade-up"
								data-aos-delay="600">{{ 'landing.feature.hours.sunday'|trans }}</strong>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ABOUT -->
	<section class="about section" id="about">
		<div class="container">
			<div class="row">
				<div class="mt-lg-5 mb-lg-0 mb-4 col-lg-5 col-md-10 mx-auto col-12">
					<h2 class="mb-4" data-aos="fade-up" data-aos-delay="300">{{ 'landing.about.title'|trans }}</h2>
					<p data-aos="fade-up" data-aos-delay="400" class="justify-text">{{ 'landing.about.intro'|trans }}</p>

					<h3 data-aos="fade-up" data-aos-delay="500"><b>{{ 'landing.about.vision_title'|trans }}</b></h3>
					<p data-aos="fade-up" data-aos-delay="500" class="justify-text">{{ 'landing.about.vision'|trans }}</p>

					<h3 data-aos="fade-up" data-aos-delay="500"><b>{{ 'landing.about.mission_title'|trans }}</b></h3>
					<p data-aos="fade-up" data-aos-delay="500" class="justify-text">{{ 'landing.about.mission'|trans }}</p>
				</div>
				<div class="col-lg-6 col-md-8 col-12 d-flex flex-column align-items-center" data-aos="fade-up"
					data-aos-delay="800">
					<div class="team-thumb mb-3">
						<img src="/index/img/Puerto.JPG" class="img-fluid large-image"
							alt="{{ 'landing.about.port_alt'|trans }}" title="{{ 'landing.about.port_title'|trans }}"
							data-aos="fade-up" data-aos-delay="800">
					</div>
					<div class="team-thumb">
						<img src="/index/img/Manzanillo.JPG" class="img-fluid large-image"
							alt="{{ 'landing.about.city_alt'|trans }}" title="{{ 'landing.about.city_title'|trans }}"
							data-aos="fade-up" data-aos-delay="800">
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- SERVICES -->
	<section class="class section" id="class">
		<div class="container">
			<div class="row text-center mb-5">
				<div class="col-12">
					<h6 data-aos="fade-up">{{ 'landing.services.tagline'|trans }}</h6>
					<h2 data-aos="fade-up" data-aos-delay="200">{{ 'landing.services.title'|trans }}</h2>
				</div>
			</div>
			<div class="row">
				{# Las cuatro tarjetas comparten maquetacion, asi que se recorren en vez
				   de repetirse: agregar un servicio es agregar una entrada aqui y sus
				   dos claves en los catalogos. #}
				{% for servicio in [
					{ key: 'consulting', img: 'auditoria-asesoramiento.jpg' },
					{ key: 'trade',      img: 'Importación-Exportación.jpg' },
					{ key: 'empty',      img: 'vacuum-handling.jpg' },
					{ key: 'freight',    img: 'ground-freight.jpg' }
				] %}
					{% set titulo = ('landing.services.' ~ servicio.key ~ '.title')|trans %}
					<div class="col-lg-3 col-md-6 col-12 mb-4" data-aos="fade-up" data-aos-delay="400">
						<div class="card h-100">
							<img src="/index/img/{{ servicio.img }}" class="card-img-top" alt="{{ titulo }}">
							<div class="card-body">
								<h5 class="card-title">{{ titulo }}</h5>
								<p class="card-text">{{ ('landing.services.' ~ servicio.key ~ '.text')|trans }}</p>
							</div>
						</div>
					</div>
				{% endfor %}
			</div>
		</div>
	</section>

	<!-- CONTACT -->
	<section class="contact section" id="contact">
		<div class="container">
			<div class="row">
				<div class="ml-auto col-lg-5 col-md-6 col-12">
					<h2 class="mb-4 pb-2" data-aos="fade-up" data-aos-delay="200">{{ 'landing.contact.title'|trans }}</h2>
					<form id="contactForm" method="post" class="contact-form webform" data-aos="fade-up"
						data-aos-delay="400" role="form">
						{# El idioma sale de la peticion, no escrito a mano en cada plantilla. #}
						<input type="hidden" id="language" name="language" value="{{ locale }}">
						<input type="text" id="name" class="form-control" name="cf-name"
							placeholder="{{ 'landing.contact.name'|trans }}">
						<input type="email" id="email" class="form-control" name="cf-email"
							placeholder="{{ 'landing.contact.email'|trans }}">
						<textarea class="form-control" id="message" rows="5" name="cf-message"
							placeholder="{{ 'landing.contact.message'|trans }}"></textarea>
						<button type="submit" class="form-control" id="submit-button" name="submit">
							{{ 'landing.contact.send'|trans }}
						</button>
					</form>
				</div>
				<div class="mx-auto mt-4 mt-lg-0 mt-md-0 col-lg-5 col-md-6 col-12">
					<h2 class="mb-4" data-aos="fade-up" data-aos-delay="600">{{ 'landing.contact.where_title'|trans }}</h2>
					<p data-aos="fade-up" data-aos-delay="800">
						<i class="fa fa-map-marker mr-1"></i> {{ 'landing.contact.address'|trans }}
					</p>
					<div class="google-map" data-aos="fade-up" data-aos-delay="900">
						<iframe
							src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3770.6065394880243!2d-104.28732872399877!3d19.08102935181317!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8424d5882fffffff%3A0x53db05372f4ea127!2sVillanueva%20Cervantes%20y%20Asociados%20S.C.!5e0!3m2!1ses!2smx!4v1740454335006!5m2!1ses!2smx"
							width="1920" height="250" frameborder="0" style="border:0;" allowfullscreen=""></iframe>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- FOOTER -->
	<footer class="site-footer">
		<div class="container">
			<div class="row">
				<div class="col-lg-2 col-md-2 d-flex justify-content-center align-items-center">
					<img src="/index/img/IAL NETWORK.png" alt="Logo" class="img-fluid" width="90px" height="auto">
				</div>
				<div class="ml-auto col-lg-4 col-md-5">
					<p class="copyright-text">{{ 'landing.footer.copyright'|trans }}</p>
				</div>
				<div class="d-flex justify-content-center mx-auto col-lg-5 col-md-7 col-12">
					<p class="mr-4">
						<i class="fa fa-envelope-o mr-1"></i>
						<a href="mailto:gerencia@ialnetwork.com?subject=Consulta">gerencia@ialnetwork.com</a>
					</p>
					<p><i class="fa fa-phone mr-1"></i> 314-331-3677</p>
				</div>
			</div>
		</div>
	</footer>

	<button id="scrollToTopBtn" class="btn btn-dark rounded-circle" title="{{ 'landing.scroll_top'|trans }}"
		onclick="scrollToTop()">
		↑
	</button>

	<!-- Alert Message -->
	<div id="alertMessage" class="alert alert-success alert-dismissible fade show" role="alert"
		style="position: fixed; bottom: 45px; right: 20px; width: 300px; display: none;">
		<strong>{{ 'landing.contact.sent_title'|trans }}</strong> {{ 'landing.contact.sent_body'|trans }}
		<button type="button" class="close" data-dismiss="alert" aria-label="Close">
			<span aria-hidden="true">&times;</span>
		</button>
	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="/index/js/email.js"></script>
	<script src="/index/js/jquery.min.js"></script>
	<script src="/index/js/bootstrap.min.js"></script>
	<script src="/index/js/aos.js"></script>
	<script src="/index/js/smoothscroll.js"></script>
	<script src="/index/js/custom.js"></script>
{% endblock %}
