<!DOCTYPE html>
<html lang="es">
<html>
<head>
  <title>{% block title %}IAL Network{% endblock %}</title>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=Edge">
  <meta name="author" content="IAL Network">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
  <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
  {% block stylesheets %}
    {{ encore_entry_link_tags('app') }}
    <style>
      body {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      .sidebar {
        height: 100vh;
        position: fixed;
        left: 0;
        top: 0;
        width: 240px;
        background-color: #343a40;
        color: white;
      }
      .sidebar .nav-link {
        color: white;
      }
      .sidebar .nav-link.active {
        background-color: #495057;
      }
      .content {
        margin-left: 240px;
        padding: 20px;
      }
      .navbar {
        margin-left: 240px;
      }
    </style>
  {% endblock %}
  {% block javascripts %}
    {{ encore_entry_script_tags('app') }}
  {% endblock %}
</head>

<body>
  <!-- Sidebar -->
  <div class="sidebar d-flex flex-column p-3">
    <h4 class="text-center">IAL Network</h4>
    <hr>
    <ul class="nav nav-pills flex-column mb-auto">
      <li class="nav-item">
        <a href="/dashboard" class="nav-link {% if app.request.pathinfo == '/dashboard' %}active{% endif %}">Inicio</a>
      </li>
      <li>
        <a href="/dashboard/usuarios" class="nav-link {% if app.request.pathinfo starts with '/dashboard/usuarios' %}active{% endif %}">Usuarios</a>
      </li>
      <li>
        <a href="/dashboard/empresas" class="nav-link {% if app.request.pathinfo starts with '/dashboard/empresas' %}active{% endif %}">Empresas</a>
      </li>
      <li>
        <a href="/dashboard/proveedores" class="nav-link {% if app.request.pathinfo starts with '/dashboard/proveedores' %}active{% endif %}">Proveedores</a>
      </li>
      <li>
        <a href="/dashboard/pedimentos" class="nav-link {% if app.request.pathinfo starts with '/dashboard/pedimentos' %}active{% endif %}">Pedimentos</a>
      </li>
      <li>
        <a href="/dashboard/contenedores" class="nav-link {% if app.request.pathinfo starts with '/dashboard/contenedores' %}active{% endif %}">Contenedores</a>
      </li>
      <li>
        <a href="/dashboard/recintos" class="nav-link {% if app.request.pathinfo starts with '/dashboard/recintos' %}active{% endif %}">Recintos</a>
      </li>
      <li>
        <a href="/dashboard/despachos" class="nav-link {% if app.request.pathinfo starts with '/dashboard/despachos' %}active{% endif %}">Despachos</a>
      </li>
      <li>
        <a href="/dashboard/vacios" class="nav-link {% if app.request.pathinfo starts with '/dashboard/vacios' %}active{% endif %}">Vacios</a>
      </li>
      <li>
        <a href="/dashboard/transportistas" class="nav-link {% if app.request.pathinfo starts with '/dashboard/transportistas' %}active{% endif %}">Transportistas</a>
      </li>
      <li>
        <a href="/dashboard/maniobras" class="nav-link {% if app.request.pathinfo starts with '/dashboard/maniobras' %}active{% endif %}">Maniobras</a>
      </li>
      <li>
        <a href="/dashboard/facturas" class="nav-link {% if app.request.pathinfo starts with '/dashboard/facturas' %}active{% endif %}">Facturas</a>
      </li>
    </ul>

    <hr>
    <div>
      <span>Usuario: {{ name }}</span>
    </div>
  </div>

  <!-- Navbar superior -->
  <nav class="navbar navbar-expand-lg bg-body-tertiary shadow-sm">
    <div class="container-fluid">
      <a class="navbar-brand" href="#">Panel de Control</a>
    </div>
  </nav>
  {% block body %}

  {% endblock %}

  {% include '_flashes.html.twig' %}
</body>
</html>