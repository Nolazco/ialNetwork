{% extends '/dashboard/baseDashboard.html.twig' %}

{% block title %}Despachos{% endblock %}

{% block body %}
  <div class="content">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
      <h2 class="mb-0">{{ isHauler ? 'Mis despachos' : 'Despachos' }}</h2>
      {% if isHauler %}
        <a href="{{ path('hauler_companies') }}" class="btn btn-outline-primary">
          <i class="bi bi-truck"></i> Mis empresas transportistas
        </a>
      {% endif %}
    </div>

    {% if isHauler and haulers is empty %}
      <div class="alert alert-warning">
        Todavía no das de alta ninguna empresa de transporte.
        <a href="{{ path('hauler_companies') }}">Da de alta la tuya</a> para poder recibir despachos.
      </div>
    {% elseif deliveries is empty %}
      <div class="card text-center">
        <div class="card-header">Aviso</div>
        <div class="card-body">
          <h5 class="card-title">Sin despachos</h5>
          <p class="card-text mb-0">
            {{ isHauler
              ? 'No tienes ningún despacho asignado por ahora.'
              : 'Todavía no se ha avisado al transporte en ningún expediente.' }}
          </p>
        </div>
      </div>
    {% else %}
      <div class="table-responsive">
      <table class="table table-striped align-middle">
        <thead>
          <tr>
            <th scope="col">Expediente</th>
            <th scope="col">Operación</th>
            <th scope="col">Recinto</th>
            <th scope="col">Transportista</th>
            <th scope="col">Cita</th>
            <th scope="col">Carga</th>
            <th scope="col">Avance</th>
            <th scope="col" class="text-end">Opciones</th>
          </tr>
        </thead>
        <tbody>
          {% for d in deliveries %}
            <tr>
              <td>
                {% for r in d.references %}
                  <div{{ not loop.first ? ' class="mt-1 pt-1 border-top"' : '' }}>
                    <strong>{{ r.clientReference }}</strong>
                    <div class="small text-body-secondary">{{ r.idCompany.name }}</div>
                  </div>
                {% endfor %}
              </td>
              <td>
                {% set first = d.references|first %}
                {{ first ? directions[first.direction]|default(first.direction) : '' }}
                {% for r in d.references %}
                  <div class="small text-body-secondary">{{ r.goods }}</div>
                {% endfor %}
              </td>
              <td>{{ (d.references|first) and (d.references|first).cr ? (d.references|first).cr.name : 'Sin asignar' }}</td>
              <td>
                {{ d.transport ? d.transport.companyName : 'Transporte pendiente' }}
                {% if d.vehicle or d.driver %}
                  <div class="small text-body-secondary">
                    {{ d.vehicle ? d.vehicle.plates : '' }}{{ d.vehicle and d.driver ? ' · ' : '' }}{{ d.driver ? d.driver.name : '' }}
                  </div>
                {% endif %}
              </td>
              <td>{{ d.date|date('d/m/Y') }} {{ d.hour|date('H:i') }}</td>
              <td>
                {% for c in d.containers %}
                  <span class="badge text-bg-secondary">{{ c.num }} &middot; {{ c.type }}</span>
                {% else %}
                  {% if d.handedOff %}
                    <span class="badge text-bg-info">Traspasado</span>
                  {% else %}
                    <span class="text-body-secondary">Carga suelta</span>
                  {% endif %}
                {% endfor %}
                {% if d.descripcion %}
                  <div class="small text-body-secondary">
                    {{ d.descripcion }} · {{ d.embalaje }} · {{ d.bultos }} bultos · {{ d.weightKg }} KG · {{ d.cubicaje }} m³
                  </div>
                  <div class="small text-body-secondary">Clave SAT: {{ d.claveSat }}</div>
                {% endif %}
                {% if d.xcfFolio %}
                  <div class="small text-body-secondary">Folio XCF: {{ d.xcfFolio }}</div>
                {% endif %}
              </td>
              <td>
                <span class="badge {{ d.stage == 'Fallido' ? 'text-bg-danger' : (d.stage == 'Entregado' ? 'text-bg-success' : (d.stage == 'Traspasado' ? 'text-bg-info' : (d.stage == 'En tránsito' ? 'text-bg-primary' : 'text-bg-secondary'))) }}">
                  {{ d.stage }}
                </span>
                {% if d.departedAt %}
                  <div class="small text-body-secondary">Salida {{ d.departedAt|date('d/m/Y H:i') }}</div>
                {% endif %}
                {% if d.deliveredAt %}
                  <div class="small text-body-secondary">Entrega {{ d.deliveredAt|date('d/m/Y H:i') }}</div>
                {% endif %}
                {% if d.failedAt %}
                  <div class="small text-danger">
                    {{ d.failureReason }}
                    <div class="text-body-secondary">
                      {{ d.failedAt|date('d/m/Y H:i') }}{{ d.failureReportedBy ? ' · ' ~ d.failureReportedBy.name : '' }}
                    </div>
                  </div>
                {% endif %}
              </td>
              {% set canDepart = isHauler and not d.failed and not d.departed %}
              {% set canArrive = isHauler and not d.failed and not d.delivered %}
              {% set canReturnEmpty = isHauler and not d.failed and d.delivered and pendingReturns[d.id] > 0 %}
              {% set allDone = isHauler and not d.failed and d.delivered and pendingReturns[d.id] == 0 %}
              {% set canAssignVehicle = isHauler and d.transport and vehiclesByHauler[d.transport.id] is defined and not d.departed and not d.failed %}
              {% set canReportFailure = not d.departed and not d.failed %}
              {% set canHandoff = d.departed and not d.delivered and not d.failed %}
              {% set hasAnyAction = canDepart or canArrive or canReturnEmpty or canAssignVehicle or canReportFailure or canHandoff %}
              <td class="text-end">
                {% if hasAnyAction %}
                  <div class="dropdown">
                    {# El menu se posiciona con Popper "fixed" (relativo a la ventana, no
                       al contenedor con scroll) porque .table-responsive de mas abajo le
                       pone overflow-x:auto a la tabla — con la posicion "absolute" que usa
                       Popper por defecto, ese overflow recorta el menu en cuanto se abre. #}
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-popper-config='{"strategy":"fixed"}' aria-expanded="false">
                      Opciones
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end" style="min-width: 260px;">
                      {% if canDepart %}
                        <li>
                          <form method="POST" action="{{ path('delivery_departure', { id: d.id }) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('delivery_departure') }}">
                            <button type="submit" class="dropdown-item">
                              <i class="bi bi-truck"></i> Salida
                            </button>
                          </form>
                        </li>
                      {% endif %}
                      {% if canArrive %}
                        <li>
                          <form method="POST" enctype="multipart/form-data" action="{{ path('delivery_arrival', { id: d.id }) }}" class="px-3 py-2">
                            <input type="hidden" name="_token" value="{{ csrf_token('delivery_arrival') }}">
                            <label class="form-label small mb-1">Prueba de entrega (opcional)</label>
                            <input type="file" class="form-control form-control-sm mb-2" name="proof">
                            <button type="submit" class="btn btn-sm btn-primary w-100">
                              <i class="bi bi-check2"></i> Confirmar entrega
                            </button>
                          </form>
                        </li>
                      {% elseif canReturnEmpty %}
                        <li>
                          <a href="{{ path('delivery_empty_returns', { id: d.id }) }}" class="dropdown-item">
                            <i class="bi bi-box-arrow-in-left"></i>
                            Devolver vacío{{ pendingReturns[d.id] > 1 ? 's' : '' }} ({{ pendingReturns[d.id] }})
                          </a>
                        </li>
                      {% endif %}
                      {% if canAssignVehicle or canReportFailure or canHandoff %}
                        <li><hr class="dropdown-divider"></li>
                      {% endif %}
                      {% if canAssignVehicle %}
                        <li>
                          <button type="button" class="dropdown-item js-assign-vehicle-toggle" data-target="assign-vehicle-{{ d.id }}">
                            <i class="bi bi-clipboard-check"></i> {{ d.vehicle ? 'Corregir unidad y chofer' : 'Unidad y chofer' }}
                          </button>
                        </li>
                      {% endif %}
                      {% if canReportFailure %}
                        <li>
                          <button type="button" class="dropdown-item text-danger js-report-failure-toggle" data-target="report-failure-{{ d.id }}">
                            <i class="bi bi-exclamation-triangle"></i> No se pudo cargar
                          </button>
                        </li>
                      {% endif %}
                      {% if canHandoff %}
                        <li>
                          <button type="button" class="dropdown-item js-handoff-toggle" data-target="handoff-{{ d.id }}">
                            <i class="bi bi-arrow-left-right"></i> Traspasar a otro transportista
                          </button>
                        </li>
                      {% endif %}
                    </ul>
                  </div>
                {% elseif allDone %}
                  <span class="text-body-secondary" title="Sin pendientes"><i class="bi bi-check2-all"></i></span>
                {% endif %}
              </td>
            </tr>
            {% if isHauler and d.transport and vehiclesByHauler[d.transport.id] is defined and not d.departed and not d.failed %}
              <tr id="assign-vehicle-{{ d.id }}" class="d-none">
                <td colspan="8">
                  <form method="POST" action="{{ path('delivery_assign_vehicle', { id: d.id }) }}" class="row g-2 align-items-end">
                    <input type="hidden" name="_token" value="{{ csrf_token('delivery_assign_vehicle') }}">
                    <div class="col-md-3">
                      <label class="form-label small">Unidad</label>
                      <select class="form-select form-select-sm" name="vehicle" required>
                        <option value="" selected disabled>Seleccione</option>
                        {% for veh in vehiclesByHauler[d.transport.id]|default([]) %}
                          <option value="{{ veh.id }}" {{ d.vehicle and d.vehicle.id == veh.id ? 'selected' : '' }}>{{ veh.plates }}</option>
                        {% endfor %}
                      </select>
                    </div>
                    <div class="col-md-3">
                      <label class="form-label small">Chofer</label>
                      <select class="form-select form-select-sm" name="driver" required>
                        <option value="" selected disabled>Seleccione</option>
                        {% for drv in driversByHauler[d.transport.id]|default([]) %}
                          <option value="{{ drv.id }}" {{ d.driver and d.driver.id == drv.id ? 'selected' : '' }}>{{ drv.name }}</option>
                        {% endfor %}
                      </select>
                    </div>
                    <div class="col-md-4">
                      <label class="form-label small">Folio CFDI</label>
                      <input type="text" class="form-control form-control-sm" name="cfdiFolio" value="{{ d.cfdiFolio }}" placeholder="Ej. 051a1466-0732-4f9c-9192-56a9736a2dd4" pattern="[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}" title="Formato UUID, ej. 051a1466-0732-4f9c-9192-56a9736a2dd4" required>
                    </div>
                    <div class="col-md-2">
                      <button type="submit" class="btn btn-sm btn-primary w-100">
                        <i class="bi bi-save"></i> Enviar
                      </button>
                    </div>
                    {% if vehiclesByHauler[d.transport.id]|default([]) is empty or driversByHauler[d.transport.id]|default([]) is empty %}
                      <div class="col-12">
                        <div class="form-text">
                          Te falta dar de alta unidades o choferes de <strong>{{ d.transport.companyName }}</strong> en
                          <a href="{{ path('hauler_fleet', { hauler: d.transport.id }) }}">Mi flota</a>.
                        </div>
                      </div>
                    {% endif %}
                  </form>
                </td>
              </tr>
            {% endif %}
            {% if not d.departed and not d.failed %}
              <tr id="report-failure-{{ d.id }}" class="d-none">
                <td colspan="8">
                  <form method="POST" action="{{ path('delivery_failure', { id: d.id }) }}" class="row g-2 align-items-end">
                    <input type="hidden" name="_token" value="{{ csrf_token('delivery_failure') }}">
                    <div class="col-md-4">
                      <label class="form-label small">Motivo por el que no se pudo cargar</label>
                      <select class="form-select form-select-sm js-failure-reason" data-target="failure-other-{{ d.id }}" name="reason" required>
                        <option value="" selected disabled>Selecciona un motivo</option>
                        {% for reason in failureReasons %}
                          <option value="{{ reason }}">{{ reason }}</option>
                        {% endfor %}
                        <option value="__otra__">Otra (especificar)…</option>
                      </select>
                    </div>
                    <div class="col-md-5 d-none" id="failure-other-{{ d.id }}">
                      <label class="form-label small">¿Cuál?</label>
                      <input type="text" class="form-control form-control-sm" name="customReason" placeholder="Describe el motivo">
                    </div>
                    <div class="col-md-3">
                      <button type="submit" class="btn btn-sm btn-danger">
                        <i class="bi bi-exclamation-triangle"></i> Marcar como fallido
                      </button>
                    </div>
                  </form>
                </td>
              </tr>
            {% endif %}
            {% if d.departed and not d.delivered and not d.failed %}
              <tr id="handoff-{{ d.id }}" class="d-none">
                <td colspan="8">
                  <form method="POST" action="{{ path('delivery_handoff', { id: d.id }) }}" class="row g-2 align-items-end">
                    <input type="hidden" name="_token" value="{{ csrf_token('delivery_handoff') }}">
                    {% if d.containers|length > 0 %}
                      <div class="col-12">
                        <label class="form-label small">Contenedores a traspasar</label>
                        <div class="d-flex flex-wrap gap-3">
                          {% for c in d.containers %}
                            <div class="form-check">
                              <input class="form-check-input" type="checkbox" name="containers[]" value="{{ c.id }}" id="handoff-container-{{ d.id }}-{{ c.id }}">
                              <label class="form-check-label small" for="handoff-container-{{ d.id }}-{{ c.id }}">{{ c.num }} &middot; {{ c.type }}</label>
                            </div>
                          {% endfor %}
                        </div>
                      </div>
                    {% elseif d.references|length > 1 %}
                      <div class="col-md-3">
                        <label class="form-label small">Expediente</label>
                        <select class="form-select form-select-sm" name="reference" required>
                          <option value="" selected disabled>Selecciona</option>
                          {% for r in d.references %}
                            <option value="{{ r.id }}">{{ r.clientReference }}</option>
                          {% endfor %}
                        </select>
                      </div>
                    {% endif %}
                    <div class="col-md-3">
                      <label class="form-label small">Dónde ocurrió</label>
                      <select class="form-select form-select-sm js-handoff-place" data-target="handoff-{{ d.id }}" name="placeType" required>
                        <option value="" selected disabled>Selecciona</option>
                        {% for place in placeTypes %}
                          <option value="{{ place }}">{{ place }}</option>
                        {% endfor %}
                      </select>
                    </div>
                    <div class="col-md-3 d-none" id="handoff-{{ d.id }}-free">
                      <label class="form-label small">Lugar</label>
                      <input type="text" class="form-control form-control-sm" name="place" placeholder="Describe el lugar">
                    </div>
                    <div class="col-md-3 d-none" id="handoff-{{ d.id }}-inspection">
                      <label class="form-label small">Punto de inspección</label>
                      <select class="form-select form-select-sm" name="inspectionPointId">
                        <option value="" selected disabled>Selecciona</option>
                        {% for p in inspectionPoints %}
                          <option value="{{ p.id }}">{{ p.name }}</option>
                        {% endfor %}
                      </select>
                    </div>
                    <div class="col-md-3">
                      <label class="form-label small">Notas (opcional)</label>
                      <input type="text" class="form-control form-control-sm" name="notes" placeholder="Ej. 2 de 5 bultos">
                    </div>
                    <div class="col-12">
                      <button type="submit" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-left-right"></i> Confirmar traspaso
                      </button>
                    </div>
                  </form>
                </td>
              </tr>
            {% endif %}
          {% endfor %}
        </tbody>
      </table>
      </div>
    {% endif %}
  </div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      // Misma fila-toggle que las demas, para capturar unidad/chofer/CFDI.
      document.querySelectorAll(".js-assign-vehicle-toggle").forEach(function (boton) {
        boton.addEventListener("click", function () {
          const fila = document.getElementById(boton.dataset.target);
          if (fila) {
            fila.classList.toggle("d-none");
          }
        });
      });

      // Igual que en el expediente: alterna la fila de captura del motivo.
      document.querySelectorAll(".js-report-failure-toggle").forEach(function (boton) {
        boton.addEventListener("click", function () {
          const fila = document.getElementById(boton.dataset.target);
          if (fila) {
            fila.classList.toggle("d-none");
          }
        });
      });

      // El motivo libre solo aparece cuando se elige "Otra".
      document.querySelectorAll(".js-failure-reason").forEach(function (select) {
        select.addEventListener("change", function () {
          const wrapper = document.getElementById(select.dataset.target);
          const isOther = select.value === "__otra__";
          wrapper.classList.toggle("d-none", !isOther);
          wrapper.querySelector("input").required = isOther;
        });
      });

      // Misma fila-toggle que "No se pudo cargar", para el traspaso.
      document.querySelectorAll(".js-handoff-toggle").forEach(function (boton) {
        boton.addEventListener("click", function () {
          const fila = document.getElementById(boton.dataset.target);
          if (fila) {
            fila.classList.toggle("d-none");
          }
        });
      });

      // Lugar libre o punto de inspección solo aparecen segun lo elegido.
      const placeFree = {{ placeFree|json_encode|raw }};
      const placeInspection = {{ placeInspection|json_encode|raw }};

      document.querySelectorAll(".js-handoff-place").forEach(function (select) {
        select.addEventListener("change", function () {
          const id = select.dataset.target;
          const freeWrapper = document.getElementById(id + "-free");
          const inspectionWrapper = document.getElementById(id + "-inspection");
          const isFree = select.value === placeFree;
          const isInspection = select.value === placeInspection;

          freeWrapper.classList.toggle("d-none", !isFree);
          freeWrapper.querySelector("input").required = isFree;

          inspectionWrapper.classList.toggle("d-none", !isInspection);
          inspectionWrapper.querySelector("select").required = isInspection;
        });
      });
    });
  </script>
{% endblock %}
