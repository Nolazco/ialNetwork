{% extends '/dashboard/baseDashboard.html.twig' %}

{% block title %}Expediente {{ import.clientReference }}{% endblock %}

{% block body %}
  <div class="content">

    <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-2">
      <div>
        <h2 class="mb-1">Expediente {{ import.clientReference }}</h2>
        <p class="text-body-secondary mb-0">
          {{ import.idCompany.name }}
          &middot; {{ directions[import.direction]|default(import.direction) }}
          &middot; {{ types[import.type]|default(import.type) }}
        </p>
      </div>
      <a href="/dashboard/pedimentos/" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Volver
      </a>
    </div>

    {# ---------- Avance del expediente ---------- #}
    <div class="card shadow-sm mb-4">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <h5 class="card-title mb-0">Avance</h5>
          <span class="badge text-bg-primary fs-6">{{ import.status }}</span>
        </div>

        <div class="progress mb-3" role="progressbar" aria-valuenow="{{ progress }}" aria-valuemin="0" aria-valuemax="100">
          <div class="progress-bar" style="width: {{ progress }}%">{{ progress }}%</div>
        </div>

        <div class="roadmap-wrapper mb-3">
          <ol class="roadmap">
            {% for step in sequence %}
              <li class="roadmap-step
                {%- if step in completed %} is-complete{% endif -%}
                {%- if step in skipped %} is-skipped{% endif -%}
                {%- if step == import.status %} is-current{% endif %}">
                <div class="roadmap-marker">
                  {% if step in completed %}
                    <i class="bi bi-check-lg"></i>
                  {% elseif step in skipped %}
                    <i class="bi bi-dash-lg"></i>
                  {% else %}
                    {{ loop.index }}
                  {% endif %}
                </div>
                <div class="roadmap-label">
                  {{ step }}
                  {% if step in skipped %}<span class="roadmap-tag">no aplicó</span>{% endif %}
                  {% if step == 'Modulado' and import.moduladoAt %}<span class="roadmap-tag">{{ import.moduladoAt|date('d/m/Y H:i') }}</span>{% endif %}
                  {% if step == import.status %}<span class="roadmap-tag roadmap-tag-current">Actual</span>{% endif %}
                </div>
              </li>
            {% endfor %}
          </ol>
        </div>

        {% if nextStatuses is empty %}
          <p class="mb-0 text-success"><i class="bi bi-flag-fill"></i> El expediente llegó al final de su recorrido.</p>
        {% elseif import.status == 'Pendiente' %}
          <p class="mb-0 text-body-secondary">
            <i class="bi bi-info-circle"></i>
            {% if missingByStatus['Capturado'] is defined and missingByStatus['Capturado']|length %}
              Falta: {{ missingByStatus['Capturado']|join(', ') }}.
            {% elseif is_granted('ROLE_EXECUTIVE') %}
              Da de alta el pedimento para que el expediente avance.
            {% else %}
              En espera de captura por parte del ejecutivo.
            {% endif %}
          </p>
        {% else %}
          <div class="d-flex gap-2 flex-wrap">
            {% for status in nextStatuses %}
              {% if not is_granted('ROLE_EXECUTIVE') %}
                <span class="text-body-secondary">Siguiente paso: {{ status }}</span>
              {% elseif status == 'Vacío devuelto' and containersPendingReturn|length %}
                {# Lo dispara el transportista al registrar el EIR de cada contenedor. #}
                <span class="text-body-secondary">
                  <i class="bi bi-hourglass-split"></i>
                  Esperando la devolución de {{ containersPendingReturn|length }} vacío(s).
                </span>
              {% elseif status == 'Finalizado' and expenses|length == 0 %}
                {# El expediente no cierra sin su cuenta de gastos. #}
                <span class="text-body-secondary">
                  <i class="bi bi-paperclip"></i>
                  Anexa la cuenta de gastos para poder finalizar.
                </span>
              {% elseif status == 'Modulado' %}
                {# Modulado ya no se marca a mano: solo lo confirma el SOIA. #}
                {% if import.importNumber and import.importNumber != 'Pendiente' %}
                  <form method="POST" action="{{ path('case_file_soia_query', { id: import.id }) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('case_file_soia_query') }}">
                    <button type="submit" class="btn btn-primary">
                      <i class="bi bi-search"></i> Consultar SOIA
                    </button>
                  </form>
                {% else %}
                  <span class="text-body-secondary">
                    <i class="bi bi-hourglass-split"></i>
                    Falta el número de pedimento para poder consultar el SOIA.
                  </span>
                {% endif %}
              {% elseif missingByStatus[status] is defined and missingByStatus[status]|length %}
                <span class="text-body-secondary">
                  <i class="bi bi-exclamation-circle"></i>
                  Falta: {{ missingByStatus[status]|join(', ') }}.
                </span>
              {% else %}
                <form method="POST" action="{{ path('case_file_advance', { id: import.id }) }}">
                  <input type="hidden" name="_token" value="{{ csrf_token('case_file_advance') }}">
                  <input type="hidden" name="status" value="{{ status }}">
                  <button type="submit" class="btn {{ loop.first ? 'btn-primary' : 'btn-outline-primary' }}">
                    {{ status }} <i class="bi bi-arrow-right"></i>
                  </button>
                </form>
              {% endif %}
            {% endfor %}
          </div>
          {% if nextStatuses|length > 1 %}
            <p class="mt-2 mb-0 small text-body-secondary">
              «{{ nextStatuses|first }}» es un paso opcional: si esta mercancía no lo requiere, pasa directo al siguiente.
            </p>
          {% endif %}
        {% endif %}
      </div>
    </div>

    <div class="row g-4">

      {# ---------- Alta del pedimento ---------- #}
      {% if is_granted('ROLE_EXECUTIVE') %}
      <div class="col-lg-6">
        <div class="card shadow-sm h-100">
          <div class="card-body">
            <h5 class="card-title mb-3">Alta del pedimento</h5>
            {% if import.status == 'Pendiente' and missingByStatus['Capturado'] is defined and missingByStatus['Capturado']|length %}
              <p class="mb-0 text-body-secondary">
                <i class="bi bi-info-circle"></i>
                Sube {{ missingByStatus['Capturado']|join(', ') }} en «Documentos del ejecutivo» antes de dar de alta el pedimento.
              </p>
            {% else %}
              <form method="POST" action="{{ path('case_file_capture', { id: import.id }) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('case_file_capture') }}">

                <div class="mb-3">
                  <label for="agencyReference" class="form-label">Referencia de la agencia</label>
                  <input type="text" class="form-control" id="agencyReference" name="agencyReference"
                         value="{{ import.agencyReference == 'Pendiente' ? '' : import.agencyReference }}"
                         placeholder="Referencia interna" required>
                </div>

                <div class="mb-3">
                  <label for="importNumber" class="form-label">Número de pedimento</label>
                  <input type="text" class="form-control" id="importNumber" name="importNumber"
                         value="{{ import.importNumber == 'Pendiente' ? '' : import.importNumber }}"
                         placeholder="Número de pedimento" required>
                </div>

                <div class="mb-3">
                  <label for="yard" class="form-label">Recinto</label>
                  <select class="form-select" id="yard" name="yard" required>
                    <option value="" {{ import.cr ? '' : 'selected disabled' }}>Seleccione un recinto</option>
                    {% for y in yards %}
                      <option value="{{ y.id }}" {{ import.cr and import.cr.id == y.id ? 'selected' : '' }}>{{ y.name }} (CR {{ y.cr }})</option>
                    {% endfor %}
                  </select>
                </div>

                <button type="submit" class="btn btn-primary">
                  <i class="bi bi-save"></i> Guardar
                </button>
              </form>
            {% endif %}
          </div>
        </div>
      </div>
      {% endif %}

      {# ---------- Datos del aviso ---------- #}
      <div class="col-lg-6">
        <div class="card shadow-sm h-100">
          <div class="card-body">
            <h5 class="card-title mb-3">Datos del aviso</h5>
            <dl class="row mb-0">
              <dt class="col-sm-5">Empresa</dt>
              <dd class="col-sm-7">{{ import.idCompany.name }} ({{ import.idCompany.rfc }})</dd>

              <dt class="col-sm-5">Proveedor</dt>
              <dd class="col-sm-7">{{ import.idProvider.name }}</dd>

              <dt class="col-sm-5">Mercancía</dt>
              <dd class="col-sm-7">{{ import.goods }}</dd>

              <dt class="col-sm-5">Fecha de arribo</dt>
              <dd class="col-sm-7">{{ import.eta|date('d/m/Y') }}</dd>

              <dt class="col-sm-5">Inspección esperada</dt>
              <dd class="col-sm-7">
                {% if import.expectedInspectionAuthority %}
                  {{ import.expectedInspectionAuthority }}
                {% else %}
                  <span class="text-body-secondary">Sin especificar</span>
                {% endif %}
              </dd>

              <dt class="col-sm-5">Recinto</dt>
              <dd class="col-sm-7">
                {% if import.cr %}
                  {{ import.cr.name }} (CR {{ import.cr.cr }})
                {% else %}
                  <span class="text-body-secondary">Pendiente de asignar</span>
                {% endif %}
              </dd>

              <dt class="col-sm-5">Contenedores</dt>
              <dd class="col-sm-7">
                {% for c in import.containers %}
                  <span class="badge text-bg-secondary">{{ c.num }} &middot; {{ c.type }}</span>
                {% else %}
                  <span class="text-body-secondary">Carga suelta</span>
                {% endfor %}
              </dd>
            </dl>
          </div>
        </div>
      </div>
    </div>

    {# ---------- Documentos del ejecutivo ---------- #}
    <div class="card shadow-sm mt-4">
      <div class="card-body">
        <h5 class="card-title mb-3">Documentos del ejecutivo</h5>

        <table class="table table-sm align-middle mb-3">
          <thead>
            <tr>
              <th scope="col">Documento</th>
              <th scope="col">Estado</th>
              {% if is_granted('ROLE_EXECUTIVE') %}<th scope="col" class="text-end">Opciones</th>{% endif %}
            </tr>
          </thead>
          <tbody>
            {% set proforma = requiredDocuments['Proforma del pedimento'] is defined ? requiredDocuments['Proforma del pedimento'] : null %}
            <tr>
              <td>Proforma del pedimento</td>
              <td>
                {% if proforma and proforma.route %}
                  <a href="/{{ proforma.route }}" target="_blank" rel="noopener" download>
                    <i class="bi bi-download"></i> {{ proforma.route|split('/')|last }}
                  </a>
                  <span class="small text-body-secondary">({{ proforma.uploadedAt ? proforma.uploadedAt|date('d/m/Y H:i') : '—' }})</span>
                {% else %}
                  <span class="badge text-bg-warning">Falta</span>
                {% endif %}
              </td>
              {% if is_granted('ROLE_EXECUTIVE') %}
                <td class="text-end">
                  <form method="POST" enctype="multipart/form-data" class="d-inline-flex gap-1 align-items-center justify-content-end"
                        action="{{ path('case_file_required_document', { id: import.id }) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('case_file_required_document') }}">
                    <input type="hidden" name="type" value="Proforma del pedimento">
                    <input type="file" class="form-control form-control-sm" name="document" style="max-width:180px" required>
                    <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap">
                      {{ proforma and proforma.route ? 'Reemplazar' : 'Subir' }}
                    </button>
                  </form>
                </td>
              {% endif %}
            </tr>

            {% for type in requiredDocumentTypes %}
              {% if type != 'Proforma del pedimento' %}
                {% set doc = requiredDocuments[type] is defined ? requiredDocuments[type] : null %}
                <tr>
                  <td>{{ type }}</td>
                  <td>
                    {% if doc and doc.route %}
                      <a href="/{{ doc.route }}" target="_blank" rel="noopener" download>
                        <i class="bi bi-download"></i> {{ doc.route|split('/')|last }}
                      </a>
                      <span class="small text-body-secondary">({{ doc.uploadedAt ? doc.uploadedAt|date('d/m/Y H:i') : '—' }})</span>
                    {% else %}
                      <span class="badge text-bg-warning">Falta</span>
                    {% endif %}
                  </td>
                  {% if is_granted('ROLE_EXECUTIVE') %}
                    <td class="text-end">
                      <form method="POST" enctype="multipart/form-data" class="d-inline-flex gap-1 align-items-center justify-content-end"
                            action="{{ path('case_file_required_document', { id: import.id }) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('case_file_required_document') }}">
                        <input type="hidden" name="type" value="{{ type }}">
                        <input type="file" class="form-control form-control-sm" name="document" style="max-width:180px" required>
                        <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap">
                          {{ doc and doc.route ? 'Reemplazar' : 'Subir' }}
                        </button>
                      </form>
                    </td>
                  {% endif %}
                </tr>
              {% endif %}
            {% endfor %}
          </tbody>
        </table>

        {# Solicitud de anticipo: no bloquea Capturado, admite varias (complementos). #}
        <h6 class="mb-2">Solicitud de anticipo <span class="small text-body-secondary fw-normal">(opcional, admite varias)</span></h6>
        {% if advanceRequests|length %}
          <table class="table table-sm align-middle mb-2">
            <tbody>
              {% for a in advanceRequests %}
                <tr>
                  <td>
                    <a href="/{{ a.route }}" target="_blank" rel="noopener" download>
                      <i class="bi bi-download"></i> {{ a.route|split('/')|last }}
                    </a>
                    <span class="small text-body-secondary">({{ a.uploadedAt ? a.uploadedAt|date('d/m/Y H:i') : '—' }})</span>
                  </td>
                  {% if is_granted('ROLE_EXECUTIVE') %}
                    <td class="text-end">
                      <form method="POST" class="d-inline js-confirm-delete"
                            action="{{ path('case_file_advance_request_delete', { id: import.id, document: a.id }) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('case_file_advance_request_delete') }}">
                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar">
                          <i class="bi bi-trash"></i>
                        </button>
                      </form>
                    </td>
                  {% endif %}
                </tr>
              {% endfor %}
            </tbody>
          </table>
        {% else %}
          <p class="small text-body-secondary">Sin solicitudes de anticipo anexadas.</p>
        {% endif %}

        {% if is_granted('ROLE_EXECUTIVE') %}
          <form method="POST" enctype="multipart/form-data" class="d-flex gap-2 align-items-center"
                action="{{ path('case_file_advance_request', { id: import.id }) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('case_file_advance_request') }}">
            <input type="file" class="form-control form-control-sm" name="document" style="max-width:220px" required>
            <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap">
              <i class="bi bi-plus-lg"></i> Agregar
            </button>
          </form>
        {% endif %}
      </div>
    </div>

    {# ---------- Documentos del aviso ---------- #}
    <div class="card shadow-sm mt-4">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h5 class="card-title mb-0">Documentos del aviso</h5>
          {% if import.importDocuments|length %}
            <span class="badge text-bg-success">{{ import.importDocuments|length }} documento(s)</span>
          {% else %}
            <span class="badge text-bg-warning">Sin documentos</span>
          {% endif %}
        </div>

        {% if import.importDocuments|length %}
          <table class="table table-sm align-middle">
            <thead>
              <tr>
                <th scope="col">Documento</th>
                <th scope="col">Tipo</th>
                <th scope="col">Fecha de subida</th>
              </tr>
            </thead>
            <tbody>
              {% for d in import.importDocuments %}
                <tr>
                  <td>
                    <a href="/{{ d.route }}" target="_blank" rel="noopener" download>
                      <i class="bi bi-download"></i> {{ d.route|split('/')|last }}
                    </a>
                  </td>
                  <td>{{ d.type }}</td>
                  <td>{{ d.uploadedAt ? d.uploadedAt|date('d/m/Y H:i') : '—' }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        {% else %}
          <p class="mb-0 text-body-secondary">Sin documentos anexos.</p>
        {% endif %}

        {% if import.status != 'Finalizado' %}
          <form method="POST" enctype="multipart/form-data" id="document-form" class="mt-3"
                action="{{ path('case_file_document', { id: import.id }) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('case_file_document') }}">

            <div id="document-rows">
              <div class="row g-2 align-items-end mb-2 document-row">
                <div class="col-md-5">
                  <label class="form-label">Tipo de documento</label>
                  <input type="text" class="form-control" name="documentTypes[]"
                         placeholder="Ej. Factura, Lista de empaque, Certificado de origen">
                </div>
                <div class="col-md-5">
                  <label class="form-label">Archivo</label>
                  <input type="file" class="form-control" name="documents[]">
                </div>
                <div class="col-md-2">
                  <button type="button" class="btn btn-outline-danger w-100 document-remove" title="Quitar">
                    <i class="bi bi-trash"></i>
                  </button>
                </div>
              </div>
            </div>

            <button type="button" class="btn btn-outline-primary btn-sm mt-1" id="document-add">
              <i class="bi bi-plus-lg"></i> Agregar documento
            </button>

            <div class="mt-3">
              <button type="submit" class="btn btn-primary">
                <i class="bi bi-paperclip"></i> Anexar
              </button>
              <span class="ms-2 small text-body-secondary">
                Permitidos: {{ allowedDocumentTypes|join(', ') }}
              </span>
            </div>
          </form>
        {% endif %}
      </div>
    </div>

    {# ---------- Transporte ---------- #}
    <div class="card shadow-sm mt-4">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h5 class="card-title mb-0">Transporte</h5>
          {% if awaitsTransport %}
            <span class="badge text-bg-warning">Pendiente de aviso</span>
          {% endif %}
        </div>

        {% if import.deliveries|length %}
          <table class="table table-sm align-middle">
            <thead>
              <tr>
                <th scope="col">Transportista</th>
                <th scope="col">Cita</th>
                <th scope="col">Carga</th>
                <th scope="col">Avance</th>
                <th scope="col" class="text-end">Opciones</th>
              </tr>
            </thead>
            <tbody>
              {% for d in import.deliveries %}
                <tr>
                  <td>
                    {% if d.transport %}
                      {{ d.transport.companyName }} <span class="text-body-secondary">(CAAT {{ d.transport.caat }})</span>
                    {% else %}
                      <span class="badge text-bg-warning">Transporte pendiente</span>
                    {% endif %}
                  </td>
                  <td>{{ d.date|date('d/m/Y') }} {{ d.hour|date('H:i') }}</td>
                  <td>
                    {% set ownContainers = d.containers|filter(c => c in import.containers) %}
                    {% for c in ownContainers %}
                      <span class="badge text-bg-secondary">{{ c.num }}</span>
                    {% else %}
                      <span class="text-body-secondary">Carga suelta</span>
                    {% endfor %}
                    {% set otherContainers = d.containers|length - ownContainers|length %}
                    {% if otherContainers > 0 %}
                      <div class="small text-body-secondary">+{{ otherContainers }} de otro expediente</div>
                    {% endif %}
                    {% set otherReferences = d.references|filter(r => r.id != import.id)|map(r => r.clientReference) %}
                    {% if otherReferences|length > 0 %}
                      <div class="small text-body-secondary">
                        Compartido con: {{ otherReferences|join(', ') }}
                      </div>
                    {% endif %}
                  </td>
                  <td>
                    <span class="badge {{ d.stage == 'Fallido' ? 'text-bg-danger' : (d.stage == 'Entregado' ? 'text-bg-success' : (d.stage == 'En tránsito' ? 'text-bg-primary' : 'text-bg-secondary')) }}">
                      {{ d.stage }}
                    </span>
                    {% if d.departedAt %}
                      <div class="small text-body-secondary">Salida {{ d.departedAt|date('d/m/Y H:i') }}</div>
                    {% endif %}
                    {% if d.deliveredAt %}
                      <div class="small text-body-secondary">
                        Entrega {{ d.deliveredAt|date('d/m/Y H:i') }}
                        {% if d.proofRoute %}
                          <a href="/{{ d.proofRoute }}" target="_blank" rel="noopener" title="Ver prueba de entrega">
                            <i class="bi bi-paperclip"></i>
                          </a>
                        {% endif %}
                      </div>
                    {% endif %}
                    {% if d.failedAt %}
                      <div class="small text-danger">
                        {{ d.failureReason }}
                        <div class="text-body-secondary">
                          {{ d.failedAt|date('d/m/Y H:i') }}{{ d.failureReportedBy ? ' · ' ~ d.failureReportedBy.name : '' }}
                        </div>
                      </div>
                    {% endif %}
                  </td>
                  <td class="text-end text-nowrap">
                    {% if not d.departed and not d.failed and is_granted('ROLE_EXECUTIVE') %}
                      <button type="button" class="btn btn-sm btn-outline-secondary js-edit-transport-toggle" data-target="edit-transport-{{ d.id }}" title="Editar">
                        <i class="bi bi-pencil"></i>
                      </button>
                      <form method="POST" class="d-inline js-confirm-delete"
                            action="{{ path('case_file_transport_cancel', { id: import.id, delivery: d.id }) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('case_file_transport_cancel') }}">
                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Cancelar aviso">
                          <i class="bi bi-x-lg"></i>
                        </button>
                      </form>
                    {% endif %}
                  </td>
                </tr>
                {% if not d.departed and not d.failed and is_granted('ROLE_EXECUTIVE') %}
                  <tr id="edit-transport-{{ d.id }}" class="d-none">
                    <td colspan="5">
                      <form method="POST" action="{{ path('case_file_transport_edit', { id: import.id, delivery: d.id }) }}" class="row g-2 align-items-end">
                        <input type="hidden" name="_token" value="{{ csrf_token('case_file_transport_edit') }}">
                        <div class="col-md-4">
                          <label class="form-label small">Transportista</label>
                          <select class="form-select form-select-sm" name="transport">
                            <option value="" {{ d.transport is null ? 'selected' : '' }}>Transporte pendiente</option>
                            {% for h in haulers %}
                              <option value="{{ h.id }}" {{ d.transport and d.transport.id == h.id ? 'selected' : '' }}>{{ h.companyName }} (CAAT {{ h.caat }})</option>
                            {% endfor %}
                          </select>
                        </div>
                        <div class="col-md-3">
                          <label class="form-label small">Fecha</label>
                          <input type="date" class="form-control form-control-sm" name="date" value="{{ d.date|date('Y-m-d') }}" required>
                        </div>
                        <div class="col-md-2">
                          <label class="form-label small">Hora</label>
                          <input type="time" class="form-control form-control-sm" name="hour" value="{{ d.hour|date('H:i') }}" required>
                        </div>
                        <div class="col-md-3">
                          <button type="submit" class="btn btn-sm btn-primary">
                            <i class="bi bi-save"></i> Actualizar
                          </button>
                        </div>
                      </form>
                    </td>
                  </tr>
                {% endif %}
              {% endfor %}
            </tbody>
          </table>
        {% endif %}

        {% if canAssignTransport and is_granted('ROLE_EXECUTIVE') %}
          {% if import.type == 'container' and unassignedContainers is empty %}
            <p class="mb-0 text-body-secondary">
              <i class="bi bi-check2-all"></i> Todos los contenedores tienen camión asignado.
            </p>
          {% else %}
            <form method="POST" action="{{ path('case_file_transport', { id: import.id }) }}" class="row g-2 align-items-end">
              <input type="hidden" name="_token" value="{{ csrf_token('case_file_transport') }}">

              <div class="col-md-4">
                <label for="transport" class="form-label">Transportista</label>
                <select class="form-select" name="transport" id="transport">
                  <option value="">Transporte pendiente (definir después)</option>
                  {% for h in haulers %}
                    <option value="{{ h.id }}">{{ h.companyName }} (CAAT {{ h.caat }})</option>
                  {% endfor %}
                </select>
              </div>

              <div class="col-md-3">
                <label for="deliveryDate" class="form-label">Fecha</label>
                <input type="date" class="form-control" name="date" id="deliveryDate" required>
              </div>

              <div class="col-md-2">
                <label for="deliveryHour" class="form-label">Hora</label>
                <input type="time" class="form-control" name="hour" id="deliveryHour" required>
              </div>

              {% if import.type == 'container' %}
                <div class="col-md-3">
                  <label class="form-label">Contenedores (máx. {{ maxContainers }})</label>
                  <div class="border rounded p-2" id="container-picker">
                    {% for c in unassignedContainers %}
                      <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="containers[]"
                               value="{{ c.id }}" id="cont-{{ c.id }}">
                        <label class="form-check-label" for="cont-{{ c.id }}">{{ c.num }} &middot; {{ c.type }}</label>
                      </div>
                    {% endfor %}
                  </div>
                </div>
              {% endif %}

              {% if shareableImports|length > 0 %}
                <div class="col-12">
                  <label class="form-label">
                    Compartir esta unidad con otro(s) expediente(s) (opcional)
                  </label>
                  <div class="border rounded p-2" style="max-height: 220px; overflow-y: auto;">
                    {% for candidate in shareableImports %}
                      <div class="form-check">
                        <input class="form-check-input js-additional-import" type="checkbox" name="additionalImports[]"
                               value="{{ candidate.id }}" id="additional-{{ candidate.id }}"
                               {% if candidate.type == 'container' %}data-container-target="additional-containers-{{ candidate.id }}"{% endif %}>
                        <label class="form-check-label" for="additional-{{ candidate.id }}">
                          {{ candidate.clientReference }} &middot; {{ candidate.idCompany.name }} &middot; {{ types[candidate.type]|default(candidate.type) }}
                        </label>
                      </div>
                    {% endfor %}
                  </div>
                  <div class="form-text">Sin restricción de empresa: puedes combinar cualquier expediente, tú decides.</div>
                </div>

                {% for candidate in shareableImports %}
                  {% if candidate.type == 'container' %}
                    <div class="col-md-4 d-none" id="additional-containers-{{ candidate.id }}">
                      <label class="form-label small">Contenedores de {{ candidate.clientReference }}</label>
                      <div class="border rounded p-2">
                        {% for c in shareableContainers[candidate.id]|default([]) %}
                          <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="containers[]" value="{{ c.id }}" id="cont-{{ c.id }}">
                            <label class="form-check-label" for="cont-{{ c.id }}">{{ c.num }} &middot; {{ c.type }}</label>
                          </div>
                        {% endfor %}
                      </div>
                    </div>
                  {% endif %}
                {% endfor %}
              {% endif %}

              <div class="col-12">
                <button type="submit" class="btn btn-primary">
                  <i class="bi bi-truck"></i> Avisar al transporte
                </button>
              </div>
            </form>
          {% endif %}
        {% elseif import.deliveries|length == 0 %}
          <p class="mb-0 text-body-secondary">
            <i class="bi bi-info-circle"></i>
            El expediente todavía no llega al punto de avisar al transporte.
          </p>
        {% endif %}
      </div>
    </div>

    {# ---------- Devolución de vacíos ---------- #}
    {% if requiresEmptyReturn %}
      <div class="card shadow-sm mt-4">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="card-title mb-0">Devolución de vacíos</h5>
            {% if containersPendingReturn|length %}
              <span class="badge text-bg-warning">{{ containersPendingReturn|length }} pendiente(s)</span>
            {% else %}
              <span class="badge text-bg-success">Completa</span>
            {% endif %}
          </div>

          {% if import.emptyReturns|length %}
            <table class="table table-sm align-middle">
              <thead>
                <tr>
                  <th scope="col">Contenedor</th>
                  <th scope="col">Patio</th>
                  <th scope="col">Tipo</th>
                  <th scope="col">Fecha</th>
                  <th scope="col">Transportista</th>
                  <th scope="col">EIR</th>
                </tr>
              </thead>
              <tbody>
                {% for e in import.emptyReturns %}
                  <tr>
                    <td>{{ e.container.num }} <span class="text-body-secondary">&middot; {{ e.container.type }}</span></td>
                    <td>{{ e.yard.name }}</td>
                    <td>{{ e.type }}</td>
                    <td>{{ e.date|date('d/m/Y') }}</td>
                    <td>{{ e.transport.companyName }}</td>
                    <td>
                      {{ e.eir }}
                      {% if e.eirRoute %}
                        <a href="/{{ e.eirRoute }}" target="_blank" rel="noopener" title="Ver EIR escaneado">
                          <i class="bi bi-file-earmark-text"></i>
                        </a>
                      {% else %}
                        <span class="badge text-bg-warning">sin escaneo</span>
                      {% endif %}
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          {% endif %}

          {% if containersPendingReturn|length %}
            <p class="mb-0 text-body-secondary">
              <i class="bi bi-hourglass-split"></i>
              Falta que el transportista devuelva:
              {% for c in containersPendingReturn %}
                <span class="badge text-bg-secondary">{{ c.num }}</span>
              {% endfor %}
            </p>
          {% endif %}
        </div>
      </div>
    {% endif %}

    {# ---------- Cuenta de gastos ---------- #}
    <div class="card shadow-sm mt-4">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h5 class="card-title mb-0">Cuenta de gastos</h5>
          {% if expenses|length %}
            <span class="badge text-bg-success">{{ expenses|length }} documento(s)</span>
          {% else %}
            <span class="badge text-bg-warning">Pendiente</span>
          {% endif %}
        </div>

        {% if expenses|length %}
          <table class="table table-sm align-middle">
            <thead>
              <tr>
                <th scope="col">Concepto</th>
                <th scope="col">Archivo</th>
                {% if is_granted('ROLE_EXECUTIVE') %}<th scope="col" class="text-end">Opciones</th>{% endif %}
              </tr>
            </thead>
            <tbody>
              {% for e in expenses %}
                <tr>
                  <td>{{ e.concept }}</td>
                  <td>
                    <a href="/{{ e.route }}" target="_blank" rel="noopener" download>
                      <i class="bi bi-download"></i> {{ e.route|split('/')|last }}
                    </a>
                  </td>
                  {% if is_granted('ROLE_EXECUTIVE') %}
                    <td class="text-end">
                      {% if import.status != 'Finalizado' %}
                        <form method="POST" class="d-inline js-confirm-delete"
                              action="{{ path('case_file_expense_delete', { id: import.id, invoice: e.id }) }}">
                          <input type="hidden" name="_token" value="{{ csrf_token('case_file_expense_delete') }}">
                          <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar documento">
                            <i class="bi bi-trash"></i>
                          </button>
                        </form>
                      {% endif %}
                    </td>
                  {% endif %}
                </tr>
              {% endfor %}
            </tbody>
          </table>
        {% elseif not is_granted('ROLE_EXECUTIVE') %}
          <p class="mb-0 text-body-secondary">
            <i class="bi bi-hourglass-split"></i>
            La agencia todavía no anexa la cuenta de gastos de este expediente.
          </p>
        {% endif %}

        {% if is_granted('ROLE_EXECUTIVE') and import.status != 'Finalizado' %}
          <form method="POST" enctype="multipart/form-data" id="expense-form"
                action="{{ path('case_file_expense', { id: import.id }) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('case_file_expense') }}">

            <div id="expense-rows">
              <div class="row g-2 align-items-end mb-2 expense-row">
                <div class="col-md-5">
                  <label class="form-label">Concepto</label>
                  <input type="text" class="form-control" name="concepts[]"
                         placeholder="Ej. Cuenta de gastos, Factura de flete">
                </div>
                <div class="col-md-5">
                  <label class="form-label">Documento</label>
                  <input type="file" class="form-control" name="documents[]">
                </div>
                <div class="col-md-2">
                  <button type="button" class="btn btn-outline-danger w-100 expense-remove" title="Quitar">
                    <i class="bi bi-trash"></i>
                  </button>
                </div>
              </div>
            </div>

            <button type="button" class="btn btn-outline-primary btn-sm mt-1" id="expense-add">
              <i class="bi bi-plus-lg"></i> Agregar documento
            </button>

            <div class="mt-3">
              <button type="submit" class="btn btn-primary">
                <i class="bi bi-paperclip"></i> Anexar
              </button>
              <span class="ms-2 small text-body-secondary">
                Permitidos: {{ allowedExpenseTypes|join(', ') }}
              </span>
            </div>
          </form>
        {% endif %}
      </div>
    </div>

    {# ---------- Previos e inspecciones ---------- #}
    <div class="card shadow-sm mt-4">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h5 class="card-title mb-0">Previos e inspecciones</h5>
          {% if is_granted('ROLE_EXECUTIVE') %}
            <a href="{{ path('case_file_previo_new', { id: import.id }) }}" class="btn btn-outline-primary btn-sm">
              <i class="bi bi-plus-lg"></i> Generar reporte de previo
            </a>
          {% endif %}
        </div>

        {% if previoReports %}
          <table class="table table-striped align-middle mb-0">
            <thead>
              <tr>
                <th scope="col">Fecha</th>
                <th scope="col">Tipo</th>
                <th scope="col">Autoridad</th>
                <th scope="col" class="text-end">Descargas</th>
                {% if is_granted('ROLE_EXECUTIVE') %}
                  <th scope="col" class="text-end">Opciones</th>
                {% endif %}
              </tr>
            </thead>
            <tbody>
              {% for previo in previoReports %}
                <tr>
                  <td>{{ previo.date|date('d/m/Y') }}</td>
                  <td>{{ previo.type }}</td>
                  <td>{{ previo.authority ?: '—' }}</td>
                  <td class="text-end">
                    <a href="/{{ previo.pdfRoute }}" class="btn btn-sm btn-outline-secondary" download title="Descargar PDF">
                      <i class="bi bi-file-earmark-pdf"></i> PDF
                    </a>
                    {% if previo.photosZipRoute %}
                      <a href="/{{ previo.photosZipRoute }}" class="btn btn-sm btn-outline-secondary" download title="Descargar fotos">
                        <i class="bi bi-file-earmark-zip"></i> Fotos
                      </a>
                    {% endif %}
                  </td>
                  {% if is_granted('ROLE_EXECUTIVE') %}
                    <td class="text-end">
                      <form method="POST" class="d-inline js-confirm-delete"
                            action="{{ path('case_file_previo_delete', { id: import.id, previo: previo.id }) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('case_file_previo_delete') }}">
                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar reporte">
                          <i class="bi bi-trash"></i>
                        </button>
                      </form>
                    </td>
                  {% endif %}
                </tr>
              {% endfor %}
            </tbody>
          </table>
        {% else %}
          <p class="text-body-secondary mb-0">Todavía no se generan reportes de previo en este expediente.</p>
        {% endif %}
      </div>
    </div>

    {# ---------- Maniobras ---------- #}
    <div class="card shadow-sm mt-4">
      <div class="card-body">
        <h5 class="card-title mb-3">Maniobras</h5>

        {% if is_granted('ROLE_EXECUTIVE') %}
        <form method="POST" action="{{ path('case_file_operation', { id: import.id }) }}" class="row g-2 align-items-end mb-4">
          <input type="hidden" name="_token" value="{{ csrf_token('case_file_operation') }}">

          <div class="col-md-5">
            <label for="maniobra" class="form-label">Maniobra</label>
            <select class="form-select" name="type" id="maniobra" required>
              <option selected disabled value="">Seleccione una maniobra</option>
              {% for m in maniobras %}
                <option value="{{ m }}">{{ m }}</option>
              {% endfor %}
              <option value="{{ maniobraOther }}">Otra (especificar)…</option>
            </select>
          </div>

          <div class="col-md-4 d-none" id="custom-maniobra-wrapper">
            <label for="customType" class="form-label">¿Cuál?</label>
            <input type="text" class="form-control" name="customType" id="customType" placeholder="Describe la maniobra">
          </div>

          <div class="col-md-3">
            <label for="maniobraDate" class="form-label">Fecha</label>
            <input type="date" class="form-control" name="date" id="maniobraDate" value="{{ "now"|date('Y-m-d') }}" required>
          </div>

          <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">
              <i class="bi bi-plus-lg"></i> Registrar
            </button>
          </div>
        </form>
        {% endif %}

        {% if operations %}
          <table class="table table-striped align-middle mb-0">
            <thead>
              <tr>
                <th scope="col">Fecha</th>
                <th scope="col">Maniobra</th>
                <th scope="col" class="text-end">Opciones</th>
              </tr>
            </thead>
            <tbody>
              {% for o in operations %}
                <tr>
                  <td>{{ o.date|date('d/m/Y') }}</td>
                  <td>{{ o.type }}</td>
                  <td class="text-end">
                    {% if is_granted('ROLE_EXECUTIVE') %}
                    <form method="POST" class="d-inline js-confirm-delete"
                          action="{{ path('case_file_operation_delete', { id: import.id, operation: o.id }) }}">
                      <input type="hidden" name="_token" value="{{ csrf_token('case_file_operation_delete') }}">
                      <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar maniobra">
                        <i class="bi bi-trash"></i>
                      </button>
                    </form>
                    {% endif %}
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        {% else %}
          <p class="text-body-secondary mb-0">Todavía no se registran maniobras en este expediente.</p>
        {% endif %}
      </div>
    </div>

  </div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      // El campo libre solo aparece cuando la maniobra no está en el catálogo.
      // El formulario de maniobras solo se renderiza para el ejecutivo, asi que
      // el cliente nunca tiene este select en el DOM.
      const select = document.getElementById("maniobra");
      const wrapper = document.getElementById("custom-maniobra-wrapper");
      const custom = document.getElementById("customType");

      if (select) {
        select.addEventListener("change", function () {
          const isOther = select.value === {{ maniobraOther|json_encode|raw }};
          wrapper.classList.toggle("d-none", !isOther);
          custom.required = isOther;
          if (!isOther) {
            custom.value = "";
          }
        });
      }

      // Agrega filas dinamicas a un formulario "una fila por archivo": la
      // cuenta de gastos (ejecutivo) y los documentos del aviso (cualquiera con
      // acceso al expediente) comparten el mismo patron.
      function habilitarFilasDinamicas(rowsId, addId, rowClass, removeClass) {
        const filas = document.getElementById(rowsId);
        const agregar = document.getElementById(addId);
        if (!filas || !agregar) return;

        agregar.addEventListener("click", function () {
          const nueva = filas.querySelector("." + rowClass).cloneNode(true);
          nueva.querySelectorAll("input").forEach(i => i.value = "");
          filas.appendChild(nueva);
        });
        filas.addEventListener("click", function (e) {
          if (!e.target.closest("." + removeClass)) return;
          const fila = e.target.closest("." + rowClass);
          if (filas.querySelectorAll("." + rowClass).length > 1) {
            fila.remove();
          } else {
            fila.querySelectorAll("input").forEach(i => i.value = "");
          }
        });
      }

      habilitarFilasDinamicas("expense-rows", "expense-add", "expense-row", "expense-remove");
      habilitarFilasDinamicas("document-rows", "document-add", "document-row", "document-remove");

      // Muestra/oculta la fila de edicion de un despacho (transportista/fecha/hora).
      document.querySelectorAll(".js-edit-transport-toggle").forEach(function (boton) {
        boton.addEventListener("click", function () {
          const fila = document.getElementById(boton.dataset.target);
          if (fila) fila.classList.toggle("d-none");
        });
      });

      // Al marcar un expediente adicional para compartir la unidad, se
      // muestran sus propios contenedores sin asignar (ya vienen precargados
      // en la pagina, sin ir de vuelta al servidor).
      document.querySelectorAll(".js-additional-import").forEach(function (checkbox) {
        checkbox.addEventListener("change", function () {
          const target = checkbox.dataset.containerTarget && document.getElementById(checkbox.dataset.containerTarget);
          if (target) {
            target.classList.toggle("d-none", !checkbox.checked);
          }
        });
      });

      // Un camión no carga más de MAX_CONTAINERS en total, sin importar de
      // cuántos expedientes distintos vengan los contenedores elegidos. El
      // servidor lo valida igual; esto solo evita que el usuario descubra el
      // error hasta enviar.
      const picker = document.getElementById("container-picker");
      if (picker) {
        const max = {{ maxContainers }};
        const form = picker.closest("form");
        form.addEventListener("change", function () {
          const boxes = form.querySelectorAll('input[name="containers[]"]');
          const marcados = [...boxes].filter(b => b.checked).length;
          boxes.forEach(b => { b.disabled = !b.checked && marcados >= max; });
        });
      }

      document.querySelectorAll(".js-confirm-delete").forEach(function (form) {
        form.addEventListener("submit", function (e) {
          e.preventDefault();
          Swal.fire({
            title: "¿Eliminar la maniobra?",
            text: "Esta acción no se puede deshacer.",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#dc3545",
            cancelButtonColor: "#6c757d",
            confirmButtonText: "Eliminar",
            cancelButtonText: "Cancelar"
          }).then(function (result) {
            if (result.isConfirmed) {
              form.submit();
            }
          });
        });
      });
    });
  </script>
{% endblock %}
