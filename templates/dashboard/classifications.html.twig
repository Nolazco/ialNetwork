{% extends '/dashboard/baseDashboard.html.twig' %}

{% block title %}Clasificaciones{% endblock %}

{% block body %}
  <div class="content">

    <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-2">
      <h2 class="mb-0">Clasificaciones</h2>
      <a href="{{ path('classification_new') }}" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Nueva solicitud
      </a>
    </div>

    {% if requests %}
      <table class="table table-striped align-middle">
        <thead>
          <tr>
            <th scope="col">Fecha</th>
            <th scope="col">Empresa</th>
            <th scope="col">Mercancía</th>
            <th scope="col">Solicitante</th>
            <th scope="col">Archivos</th>
          </tr>
        </thead>
        <tbody>
          {% for r in requests %}
            <tr>
              <td>{{ r.createdAt|date('d/m/Y H:i') }}</td>
              <td>{{ r.company.name }}</td>
              <td>{{ r.merchandiseName }}</td>
              <td>{{ r.requestedBy.name }}</td>
              <td>
                {% for a in r.attachments %}
                  <a href="/{{ a.ruta }}" download title="{{ a.nombre }}">
                    <i class="bi bi-paperclip"></i>
                  </a>
                {% endfor %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    {% else %}
      <div class="card text-center">
        <div class="card-header">Aviso</div>
        <div class="card-body">
          <h5 class="card-title">Sin registros</h5>
          <p class="card-text">Todavía no se solicita ninguna clasificación.</p>
          <a href="{{ path('classification_new') }}" class="btn btn-primary">Nueva solicitud</a>
        </div>
        <div class="card-footer text-body-secondary"></div>
      </div>
    {% endif %}

  </div>
{% endblock %}
