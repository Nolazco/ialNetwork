{% extends 'base.html.twig' %}

{% block title %}Solicitud de clasificación{% endblock %}

{% block body %}
  <div class="container py-4" style="max-width: 900px;">
    <div class="text-center mb-4">
      <img src="/index/img/IAL NETWORK.png" alt="Logo IAL Network" style="max-height: 70px;">
      <h2 class="mt-3 mb-0">Solicitud de clasificación</h2>
    </div>

    <form method="POST" enctype="multipart/form-data" action="{{ path('legacy_classification_create') }}">
      <input type="hidden" name="_token" value="{{ csrf_token('legacy_classification_create') }}">

      <div class="card shadow-sm mb-4">
        <div class="card-body">
          <div class="row g-3">
            <div class="col-md-4">
              <label for="requesterName" class="form-label">Nombre del solicitante</label>
              <input type="text" class="form-control" name="requesterName" id="requesterName" placeholder="Nombre completo" required>
            </div>
            <div class="col-md-4">
              <label for="requesterEmail" class="form-label">Correo del solicitante</label>
              <input type="email" class="form-control" name="requesterEmail" id="requesterEmail" placeholder="fulano@empresa.mx" required>
            </div>
            <div class="col-md-4">
              <label for="companyName" class="form-label">Empresa importadora</label>
              <input type="text" class="form-control" name="companyName" id="companyName" placeholder="Empresa" required>
            </div>

            <div class="col-md-6">
              <label for="merchandiseName" class="form-label">Nombre comercial de la mercancía</label>
              <input type="text" class="form-control" name="merchandiseName" id="merchandiseName" placeholder="Paracetamol, Ibuprofen, etc..." required>
            </div>
            <div class="col-md-6">
              <label for="chemicalName" class="form-label">Nombre químico (opcional)</label>
              <input type="text" class="form-control" name="chemicalName" id="chemicalName" placeholder="4-Acetamidophenol">
            </div>

            <div class="col-md-4">
              <label for="casNumber" class="form-label">Número de CAS (opcional)</label>
              <input type="text" class="form-control" name="casNumber" id="casNumber" placeholder="XXX-XX-X">
            </div>
            <div class="col-md-4">
              <label for="merchandiseUse" class="form-label">Uso de la mercancía</label>
              <input type="text" class="form-control" name="merchandiseUse" id="merchandiseUse" placeholder="Humano, Veterinario, Plaguicida" required>
            </div>
            <div class="col-md-4">
              <label for="presentation" class="form-label">Presentación de la mercancía</label>
              <input type="text" class="form-control" name="presentation" id="presentation" placeholder="Polvo, Granular, Tabletas" required>
            </div>

            <div class="col-12">
              <label for="documents" class="form-label">Archivos a enviar (COA, MSDS, cualquier archivo que consideres necesario)</label>
              <input type="file" class="form-control" name="documents[]" id="documents" multiple required>
              <div class="form-text">Permitidos: {{ allowedExtensions|join(', ') }}.</div>
            </div>
          </div>
        </div>
      </div>

      <div class="text-center">
        <button type="submit" class="btn btn-primary">Enviar solicitud</button>
      </div>
    </form>
  </div>
{% endblock %}
