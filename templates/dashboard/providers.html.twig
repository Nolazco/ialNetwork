{% extends '/dashboard/baseDashboard.html.twig' %}
{% block body %}
  <!-- Contenido principal -->
  <div class="content">
    <h2 class="mb-4">Proveedores</h2>
    {% if providers %}
      <a href="/dashboard/proveedores/nuevo" class="btn btn-primary">Nuevo proveedor</a>
      <table class="table table-striped">
        <thead>
          <tr>
            <th scope="col">Nombre</th>
            <th scope="col">TAX ID</th>
            <th scope="col">Domicilio</th>
            <th scope="col">Opciones</th>
          </tr>
        </thead>
        <tbody>
          {% for p in providers %}
            <tr>
              <td>{{ p.name }}</td>
              <td>{{ p.taxId }}</td>
              <td>{{ p.address }}</td>
              <td>
                <button 
                  class="btn btn-warning edit-provider-btn"
                  title="Editar proveedor"
                  data-id="{{ p.id }}"
                  data-name="{{ p.name }}"
                  data-address="{{ p.address }}"
                  data-taxId="{{ p.taxId }}">
                  <i class="bi bi-pencil-square"></i>
                </button>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    {% else %}
      <div class="card text-center">
        <div class="card-header">
          Aviso
        </div>
        <div class="card-body">
          <h5 class="card-title">Sin registros</h5>
          <p class="card-text">Da de alta un proveedor nuevo.</p>
          <a href="/dashboard/proveedores/nuevo" class="btn btn-primary">Nuevo proveedor</a>
        </div>
        <div class="card-footer text-body-secondary"></div>
      </div>
    {% endif %}
  </div>

  {% for tipo, mensajes in app.flashes %}
    {% for mensaje in mensajes %}
      <script>
        Swal.fire({
          title: "{% if tipo == 'success' %}Éxito{% else %}Error{% endif %}",
          text: "{{ mensaje }}",
          icon: "{{ tipo }}"
        });
      </script>
    {% endfor %}
  {% endfor %}
{% endblock %}

{% block javascripts %}
  <script>
    document.addEventListener("DOMContentLoaded", function() {
      function showConfirmation({ title, text, icon, confirmButtonText, confirmButtonColor }, onConfirm) {
        Swal.fire({
          title,
          text,
          icon,
          showCancelButton: true,
          confirmButtonColor,
          cancelButtonColor: "#6c757d",
          confirmButtonText,
          cancelButtonText: "Cancelar"
        }).then((result) => {
          if (result.isConfirmed) {
            onConfirm();
          }
        });
      }

      function handleEditClick(e) {
        const btn = e.currentTarget;
        const provId = btn.getAttribute("data-id");
        const currentName = btn.getAttribute("data-name");
        const currentAddress = btn.getAttribute("data-address");
        const currentTaxId = btn.getAttribute("data-taxId");

        Swal.fire({
          title: "Editar proveedor",
          html: `
            <input id="swal-name" class="swal2-input" placeholder="Razon Social" value="${currentName}">
            <input id="swal-address" class="swal2-input" placeholder="Domicilio" value="${currentAddress}">
            <input id="swal-taxId" class="swal2-input" placeholder="RFC" value="${currentTaxId}">
          `,
          focusConfirm: false,
          showCancelButton: true,
          confirmButtonText: "Guardar",
          cancelButtonText: "Cancelar",
          preConfirm: () => {
            const name = document.getElementById("swal-name").value.trim();
            const address = document.getElementById("swal-address").value.trim();
            const taxId = document.getElementById("swal-taxId").value.trim();

            if (!name || !address || !taxId) {
              Swal.showValidationMessage("Todos los campos son obligatorios");
              return false;
            }

            return { name, address, taxId };
          }
        }).then(result => {
          if (result.isConfirmed) {
            const updatedData = result.value;

            fetch(`/dashboard/proveedores/${provId}/editar`, {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                "X-Requested-With": "XMLHttpRequest"
              },
              body: JSON.stringify(updatedData)
            })
            .then(res => res.json())
            .then(data => {
              if (data.success) {
                Swal.fire("¡Actualizado!", "El proveedor fue editado correctamente.", "success");

                btn.setAttribute("data-name", updatedData.name);
                btn.setAttribute("data-address", updatedData.address);
                btn.setAttribute("data-taxId", updatedData.taxId);

                const row = btn.closest("tr");
                row.children[0].textContent = updatedData.name;
                row.children[1].textContent = updatedData.taxId;
                row.children[2].textContent = updatedData.address;
              } else {
                Swal.fire("Error", data.message || "Ocurrió un error al actualizar.", "error");
              }
            });
          }
        });
      }

      document.querySelectorAll(".edit-provider-btn").forEach(btn => {
        btn.addEventListener("click", handleEditClick);
      });
    });
  </script>
{% endblock %}