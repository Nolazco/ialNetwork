{% extends '/dashboard/baseDashboard.html.twig' %}
{% block body %}
	<!-- Contenido principal -->
  <div class="content">
    <form action="/dashboard/forwarders/new" method="POST">
      <input type="hidden" name="_token" value="{{ csrf_token('create_forwarder') }}">
      <div class="row">
        <div class="col">
          <label for="name" class="form-label">Nombre</label>
          <input type="text" class="form-control" id="name" name="name" placeholder="Nombre del forwarder" required>
        </div>
      </div>

      <div class="row mt-3">
        <div class="col">
          <label for="contactEmails" class="form-label">Correos de contacto</label>
          <input type="text" class="form-control" id="contactEmails" name="contactEmails" placeholder="correo1@forwarder.com; correo2@forwarder.com">
          <div class="form-text">Puedes capturar varios, separados por punto y coma.</div>
        </div>
      </div>

      <p class="text-body-secondary small mt-3">
        <i class="bi bi-info-circle"></i>
        Las cuentas bancarias se agregan después, desde el listado de forwarders.
      </p>

      <div>
        <input class="btn btn-primary mt-3" type="submit" name="submit" id="submit" value="Guardar">
      </div>
    </form>
  </div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
{% endblock %}
