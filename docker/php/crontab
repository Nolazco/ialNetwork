# Consulta el SOIA de los expedientes en Programado (ver src/Command/PollSoiaCommand.php).
# El propio comando decide, expediente por expediente, si ya le toca
# consultar (30 minutos tras la cita, cada ~2 minutos despues, hasta 1440
# intentos = ~48 horas), y ademas revisa como maximo 10 expedientes por
# corrida para no bombardear al SOIA de un jalon cuando hay muchos elegibles
# a la vez -- por eso el cron corre cada 2 minutos en vez de cada 5.
#
# El job carga /etc/container_env.sh antes de correr el comando: cron no
# hereda DATABASE_URL/MAILER_DSN/etc. del contenedor (ver entrypoint.sh), y
# sin esas variables el comando ni siquiera logra conectarse a la base.
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

*/2 * * * * www-data . /etc/container_env.sh && cd /app && php bin/console app:soia:poll >> var/log/soia_poll.log 2>&1
