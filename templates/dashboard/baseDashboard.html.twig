<!DOCTYPE html>
<html lang="es">
<html>
<head>
  <title>{% block title %}IAL Network{% endblock %}</title>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=Edge">
  <meta name="author" content="IAL Network">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
  <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
  {# Token que las llamadas fetch() mandan en la cabecera X-CSRF-Token.
     Ver App\Controller\AjaxCsrfTrait. #}
  <meta name="csrf-token" content="{{ csrf_token('ajax') }}">
  {% block stylesheets %}
    {{ encore_entry_link_tags('app') }}
    <style>
      body {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      .sidebar {
        height: 100vh;
        position: fixed;
        left: 0;
        top: 0;
        width: 240px;
        background-color: #343a40;
        color: white;
      }
      .sidebar .nav-link {
        color: white;
      }
      .sidebar .nav-link.active {
        background-color: #495057;
      }
      .content {
        margin-left: 240px;
        padding: 20px;
      }
      .navbar {
        margin-left: 240px;
      }
    </style>
  {% endblock %}
  {% block javascripts %}
    {{ encore_entry_script_tags('app') }}
  {% endblock %}
</head>

<body>
  <!-- Sidebar -->
  <div class="sidebar d-flex flex-column p-3">
    <h4 class="text-center">IAL Network</h4>
    <hr>
    <ul class="nav nav-pills flex-column mb-auto">
      {# Cada rol solo ve lo que puede abrir: antes el menu era el mismo para
         todos y la mitad de los enlaces terminaba en un 403 o en un 404. #}
      <li class="nav-item">
        <a href="/dashboard" class="nav-link {% if app.request.pathinfo == '/dashboard' %}active{% endif %}">Inicio</a>
      </li>
      {% if is_granted('ROLE_ADMIN') %}
        <li>
          <a href="/dashboard/usuarios" class="nav-link {% if app.request.pathinfo starts with '/dashboard/usuarios' %}active{% endif %}">Usuarios</a>
        </li>
      {% endif %}
      {% if is_granted('ROLE_EXECUTIVE') or is_granted('ROLE_CLIENT') %}
        <li>
          <a href="/dashboard/empresas" class="nav-link {% if app.request.pathinfo starts with '/dashboard/empresas' %}active{% endif %}">Empresas</a>
        </li>
      {% endif %}
      {% if is_granted('ROLE_EXECUTIVE') %}
        <li>
          <a href="/dashboard/proveedores" class="nav-link {% if app.request.pathinfo starts with '/dashboard/proveedores' %}active{% endif %}">Proveedores</a>
        </li>
        <li>
          <a href="/dashboard/pedimentos/" class="nav-link {% if app.request.pathinfo starts with '/dashboard/pedimentos' %}active{% endif %}">Pedimentos</a>
        </li>
        <li>
          <a href="/dashboard/recintos" class="nav-link {% if app.request.pathinfo starts with '/dashboard/recintos' %}active{% endif %}">Recintos</a>
        </li>
        <li>
          <a href="/dashboard/afiliaciones" class="nav-link {% if app.request.pathinfo starts with '/dashboard/afiliaciones' %}active{% endif %}">Afiliaciones</a>
        </li>
      {% endif %}
      {% if is_granted('ROLE_EXECUTIVE') or is_granted('ROLE_FH') %}
        <li>
          <a href="/dashboard/despachos" class="nav-link {% if app.request.pathinfo starts with '/dashboard/despachos' %}active{% endif %}">Despachos</a>
        </li>
      {% endif %}
    </ul>

    <hr>
    <div>
      <span>Usuario: {{ name }}</span>
    </div>
  </div>

  <!-- Navbar superior -->
  <nav class="navbar navbar-expand-lg bg-body-tertiary shadow-sm">
    <div class="container-fluid">
      <a class="navbar-brand" href="#">Panel de Control</a>
    </div>
  </nav>
  {% block body %}

  {% endblock %}

  {% include '_flashes.html.twig' %}
</body>
</html>