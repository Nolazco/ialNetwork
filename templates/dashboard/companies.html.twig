{% extends '/dashboard/baseDashboard.html.twig' %}
{% block body %}
  <!-- Contenido principal -->
  <div class="content">
    <h2 class="mb-4">Empresas</h2>
    {% if companies %}
      <a href="/dashboard/empresas/nueva" class="btn btn-primary">Nueva empresa</a> <a href="#"
        class="btn btn-primary" id="btn-associate">Afiliarme a una empresa</a>
      <table class="table table-striped">
        <thead>
          <tr>
            <th scope="col">Nombre</th>
            <th scope="col">RFC</th>
            <th scope="col">Domicilio</th>
            <th scope="col">Ver pedimentos</th>
            <th scope="col">Opciones</th>
          </tr>
        </thead>
        <tbody>
          {% for c in companies %}
            <tr>
              <td>{{ c.name }}</td>
              <td>{{ c.rfc }}</td>
              <td>{{ c.address }}</td>
              <td><a href="/dashboard/pedimentos/{{ c.rfc }}" class="btn btn-primary"><i class="bi bi-truck"></i></a></td>
              <td>
                <button 
                  class="btn btn-warning edit-company-btn"
                  title="Editar empresa"
                  data-id="{{ c.id }}"
                  data-name="{{ c.name }}"
                  data-address="{{ c.address }}"
                  data-rfc="{{ c.rfc }}">
                  <i class="bi bi-pencil-square"></i>
                </button>
                <button
                  class="btn btn-success view-documents"
                  title="Ver documentos"
                  data-id="{{ c.id }}">
                  <i class="bi bi-file-pdf"></i>
                </button>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    {% else %}
      <div class="card text-center">
        <div class="card-header">
          Aviso
        </div>
        <div class="card-body">
          <h5 class="card-title">Sin registros</h5>
          <p class="card-text">Da de alta una empresa o registrate en una.</p>
          <a href="/dashboard/empresas/nueva" class="btn btn-primary">Nueva empresa</a> <a href="#" id="btn-associate"
            class="btn btn-primary">Afiliarme a una empresa</a>
        </div>
        <div class="card-footer text-body-secondary"></div>
      </div>
    {% endif %}
  </div>

{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script>
    document.addEventListener("DOMContentLoaded", function() {
      function showConfirmation({ title, text, icon, confirmButtonText, confirmButtonColor }, onConfirm) {
        Swal.fire({
          title,
          text,
          icon,
          showCancelButton: true,
          confirmButtonColor,
          cancelButtonColor: "#6c757d",
          confirmButtonText,
          cancelButtonText: "Cancelar"
        }).then((result) => {
          if (result.isConfirmed) {
            onConfirm();
          }
        });
      }

      function handleEditClick(e) {
        const btn = e.currentTarget;
        const compId = btn.getAttribute("data-id");
        const currentName = btn.getAttribute("data-name");
        const currentAddress = btn.getAttribute("data-address");
        const currentRfc = btn.getAttribute("data-rfc");

        Swal.fire({
          title: "Editar empresa",
          html: `
            <input id="swal-name" class="swal2-input" placeholder="Razon Social" value="${currentName}">
            <input id="swal-address" class="swal2-input" placeholder="Domicilio" value="${currentAddress}">
            <input id="swal-rfc" class="swal2-input" placeholder="RFC" value="${currentRfc}">
          `,
          focusConfirm: false,
          showCancelButton: true,
          confirmButtonText: "Guardar",
          cancelButtonText: "Cancelar",
          preConfirm: () => {
            const name = document.getElementById("swal-name").value.trim();
            const address = document.getElementById("swal-address").value.trim();
            const rfc = document.getElementById("swal-rfc").value.trim();

            if (!name || !address || !rfc) {
              Swal.showValidationMessage("Todos los campos son obligatorios");
              return false;
            }

            return { name, address, rfc };
          }
        }).then(result => {
          if (result.isConfirmed) {
            const updatedData = result.value;

            fetch(`/dashboard/empresas/${compId}/editar`, {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                "X-Requested-With": "XMLHttpRequest"
              },
              body: JSON.stringify(updatedData)
            })
            .then(res => res.json())
            .then(data => {
              if (data.success) {
                Swal.fire("¡Actualizado!", "La empresa fue editada correctamente.", "success");

                btn.setAttribute("data-name", updatedData.name);
                btn.setAttribute("data-address", updatedData.address);
                btn.setAttribute("data-rfc", updatedData.rfc);

                const row = btn.closest("tr");
                row.children[0].textContent = updatedData.name;
                row.children[1].textContent = updatedData.address;
                row.children[2].textContent = updatedData.rfc;
              } else {
                Swal.fire("Error", data.message || "Ocurrió un error al actualizar.", "error");
              }
            });
          }
        });
      }

      document.getElementById('btn-associate').addEventListener('click', function(e) {
        e.preventDefault();

        fetch('/dashboard/empresas/disponibles', {
          method: 'GET',
          headers: {
            'Accept': 'application/json'
          }
        })
          .then(res => res.json())
          .then(data => {
            if (!data.empresas.length) {
              Swal.fire('¡Sin empresas!', 'Ya estás afiliado a todas las empresas disponibles.', 'info');
              return;
            }

            Swal.fire({
              title: 'Selecciona una empresa',
              input: 'select',
              inputOptions: data.empresas.reduce((options, empresa) => {
                options[empresa.id] = empresa.name + ' (' + empresa.rfc + ')';
                return options;
              }, {}),
              inputPlaceholder: 'Selecciona una empresa...',
              showCancelButton: true,
              confirmButtonText: 'Afiliarme',
              cancelButtonText: 'Cancelar'
            }).then(result => {
              if (result.isConfirmed && result.value) {
                console.log(result.value);
                fetch('/dashboard/empresas/afiliar/' + result.value, {
                  method: 'POST',
                  headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Content-Type': 'application/json'
                  }
                }).then(res => res.json()).then(data => {
                  Swal.fire(
                    'Solicitud enviada',
                    data.message || 'Tu solicitud quedó pendiente de autorización por la agencia.',
                    'info'
                  ).then(() => location.reload());
                });
              }
            });
          });
      });

      document.querySelectorAll('.view-documents').forEach(btn => {
        btn.addEventListener('click', async () => {
          const companyId = btn.dataset.id;

          const res = await fetch(`/dashboard/empresas/${companyId}/documentos`);
          const data = await res.json();

          if (data.error) {
            Swal.fire('Error', data.error, 'error');
            return;
          }

          const docs = data.documents;

          let html = `<ul class="list-group">`;

          docs.forEach(doc => {
            html += `
              <li class="list-group-item d-flex justify-content-between align-items-center">
                <a href="/${doc.route}" target="_blank">${doc.type || 'Documento sin nombre'}</a>
                <div>
                  <button class="btn btn-sm btn-warning edit-doc" data-id="${doc.id}">Editar</button>
                  <button class="btn btn-sm btn-danger delete-doc" data-id="${doc.id}">Eliminar</button>
                </div>
              </li>`;
          });

          html += `
            </ul>
            <div class="mt-3 text-end">
              <button class="btn btn-primary" id="add-doc">Agregar nuevo documento</button>
            </div>`;

          Swal.fire({
            title: 'Documentos de la empresa',
            html: html,
            width: '600px',
            showConfirmButton: false,
            didOpen: () => {
              document.querySelectorAll('.delete-doc').forEach(delBtn => {
                delBtn.addEventListener('click', () => {
                  const docId = delBtn.dataset.id;

                  showConfirmation({
                    title: '¿Eliminar documento?',
                    text: 'Esta acción no se puede deshacer.',
                    icon: 'warning',
                    confirmButtonText: 'Sí, eliminar',
                    confirmButtonColor: '#d33'
                  }, async () => {
                    try {
                      const res = await fetch(`/dashboard/empresas/documentos/${docId}/eliminar`, {
                        method: 'DELETE',
                        headers: {
                          'X-Requested-With': 'XMLHttpRequest'
                        }
                      });

                      const result = await res.json();

                      if (res.ok && result.success) {
                        Swal.fire('Eliminado', 'El documento fue eliminado correctamente.', 'success')
                          .then(() => location.reload());
                      } else {
                        Swal.fire('Error', result.error || 'No se pudo eliminar el documento.', 'error');
                      }
                    } catch (err) {
                      Swal.fire('Error', err.message || 'Error inesperado.', 'error');
                    }
                  });
                });
              });

              document.querySelectorAll('.edit-doc').forEach(editBtn => {
                editBtn.addEventListener('click', () => {
                  const docId = editBtn.dataset.id;

                  Swal.fire({
                    title: 'Editar documento',
                    html: `
                      <input type="text" id="edit-type" class="swal2-input" placeholder="Tipo de documento">
                      <input type="file" id="edit-file" class="swal2-file" accept=".pdf">
                    `,
                    showCancelButton: true,
                    confirmButtonText: 'Guardar',
                    preConfirm: async () => {
                      const type = document.getElementById('edit-type').value.trim();
                      const file = document.getElementById('edit-file').files[0];

                      if (!type && !file) {
                        Swal.showValidationMessage('Debes modificar al menos un campo.');
                        return false;
                      }

                      const formData = new FormData();
                      if (type) formData.append('type', type);
                      if (file) formData.append('document', file);

                      try {
                        const res = await fetch(`/dashboard/empresas/documentos/${docId}/editar`, {
                          method: 'POST',
                          body: formData
                        });

                        const result = await res.json();

                        if (!res.ok || result.error) {
                          throw new Error(result.error || 'No se pudo editar');
                        }

                        Swal.fire('Éxito', 'Documento editado correctamente', 'success').then(() => {
                          location.reload();
                        });
                      } catch (err) {
                        Swal.showValidationMessage(`Error: ${err.message}`);
                      }
                    }
                  });
                });
              });

              document.getElementById('add-doc').addEventListener('click', () => {
                Swal.fire({
                  title: 'Agregar nuevo documento',
                  html: `
                    <input type="text" id="doc-type" class="swal2-input" placeholder="Tipo de documento">
                    <input type="file" id="doc-file" class="swal2-file" accept=".pdf">
                  `,
                  showCancelButton: true,
                  confirmButtonText: 'Guardar',
                  preConfirm: async () => {
                    const type = document.getElementById('doc-type').value;
                    const file = document.getElementById('doc-file').files[0];

                    if (!type || !file) {
                      Swal.showValidationMessage('Completa todos los campos');
                      return false;
                    }

                    const formData = new FormData();
                    formData.append('type', type);
                    formData.append('document', file);

                    try {
                      const res = await fetch(`/dashboard/empresas/${companyId}/documentos/nuevo`, {
                        method: 'POST',
                        body: formData
                      });

                      const result = await res.json();

                      if (!res.ok || result.error) {
                        throw new Error(result.error || 'Error al subir documento');
                      }

                      Swal.fire('Éxito', 'Documento agregado correctamente', 'success').then(() => {
                        location.reload();
                      });
                    } catch (err) {
                      Swal.showValidationMessage(`Error: ${err.message}`);
                    }
                  }
                });
              });
            }
          });
        });
      });

      document.querySelectorAll(".edit-company-btn").forEach(btn => {
        btn.addEventListener("click", handleEditClick);
      });
    });
  </script>
{% endblock %}