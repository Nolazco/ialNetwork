{% extends '/dashboard/baseDashboard.html.twig' %}
{% block body %}
	<!-- Contenido principal -->
  <div class="content">
    <form action="/dashboard/facturadores/new" method="POST">
      <input type="hidden" name="_token" value="{{ csrf_token('create_biller') }}">
      <div class="row">
        <div class="col">
          <label for="name" class="form-label">Razón social</label>
          <input type="text" class="form-control" id="name" name="name" placeholder="Razón social del facturador" required>
        </div>
      </div>

      <div class="row mt-3">
        <div class="col">
          <label for="address" class="form-label">Domicilio</label>
          <input type="text" class="form-control" id="address" name="address" placeholder="Domicilio fiscal" required>
        </div>
      </div>

      <div class="row mt-3">
        <div class="col">
          <label for="rfc" class="form-label">RFC</label>
          <input type="text" class="form-control" id="rfc" name="rfc" placeholder="RFC" required>
        </div>
      </div>

      <div>
        <input class="btn btn-primary mt-3" type="submit" name="submit" id="submit" value="Guardar">
      </div>
    </form>
  </div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
{% endblock %}
